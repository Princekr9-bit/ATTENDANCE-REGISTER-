        return `<div class="list-row" data-selectpay="wage|${w.id}" style="cursor:pointer;"><div><div class="l1">${dispDate(w.date)}</div><div class="l2">${w.note||''}</div></div><div style="text-align:right;"><div class="amt-out">${rupee(w.amount)}</div>${isSel?`<div style="margin-top:4px;">${iconActionsHtml('data-editpay','wage|'+w.id,'data-delpay','wage|'+w.id)}</div>`:''}</div></div>`;
      }).join('') : `<div class="meta" style="color:var(--ink-soft);">${t('no_payment_7days')}</div>`;
      bodyHtml += `<div class="section-title">${t('advance_pay_history')} <span style="font-size:0.72rem;font-weight:400;color:var(--ink-soft);">${t('last_7_days_note')}</span></div>`;
      const myAdvWeek = myAdv.filter(a=>a.date>=weekAgoStr);
      bodyHtml += myAdvWeek.length ? myAdvWeek.map(a=>{
        if(state._editPay && state._editPay.type==='adv' && state._editPay.id===a.id){
          return `<div class="form-box" style="margin-bottom:10px;">
            <label>${t('date_label')}</label><input type="date" id="editPayDate" value="${a.date}">
            <label>${t('amount')} (₹)</label><input type="number" id="editPayAmt" value="${a.amount}">
            <label>${t('notes_title')}</label><input type="text" id="editPayNote" value="${a.note||''}">
            <div class="row2" style="margin-top:8px;">
              <button class="save-btn" id="editPaySave" style="margin:0;">${t('save')}</button>
              <button class="link-btn" id="editPayCancel" style="margin:0;">${t('cancel_word')}</button>
