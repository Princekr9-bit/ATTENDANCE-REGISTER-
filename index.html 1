        </select>
      </div>`;
      const monthsData = [];
      let yearIncome=0, yearExpense=0;
      let catWage=0, catVehicle=0, catMaterial=0, catPetrol=0, catOther=0;
      for(let mo=1; mo<=12; mo++){
        const mk = plYear+'-'+pad2(mo);
        const list = siteId==='ALL' ? transactions.filter(t=>monthKey(t.date)===mk) : transactions.filter(t=>monthKey(t.date)===mk && t.siteId===siteId);
        const inc = list.filter(t=>t.type==='income').reduce((a,b)=>a+b.amount,0);
        let exp = list.filter(t=>t.type==='expense').reduce((a,b)=>a+b.amount,0);
        list.filter(t=>t.type==='expense').forEach(t=>{
          if(t.category==='petrol') catPetrol += t.amount;
          else if(t.vehicleId) catVehicle += t.amount;
          else if(t.itemId) catMaterial += t.amount;
          else catOther += t.amount;
