  function buildCalendarHtml(monthStr, statusForDay, hasHalfDay){
    const [y,m] = monthStr.split('-').map(Number);
    const firstDow = new Date(y, m-1, 1).getDay();
    const daysInMonth = new Date(y, m, 0).getDate();
    const dows = ['S','M','T','W','T','F','S'];
    let html = `<div class="cal-legend">
      <span><span class="dot" style="background:var(--green);"></span> Full day</span>
      ${hasHalfDay?'<span><span class="dot" style="background:var(--amber);"></span> Half day</span>':''}
      <span><span class="dot" style="background:var(--red);"></span> Absent</span>
      <span><span class="dot" style="background:#EEF0F4;"></span> Not marked</span>
    </div>`;
    html += `<div class="cal-grid">`;
    dows.forEach(d=>{ html += `<div class="cal-dow">${d}</div>`; });
    for(let i=0;i<firstDow;i++){ html += `<div class="cal-day blank"></div>`; }
    let counts = {P:0,H:0,A:0};
    for(let d=1; d<=daysInMonth; d++){
      const dateStr = monthStr+'-'+pad2(d);
      const st = statusForDay(dateStr);
      if(st) counts[st] = (counts[st]||0)+1;
      html += `<div class="cal-day ${st||''}" data-date="${dateStr}">${d}</div>`;
    }
    html += `</div>`;
    return { html, counts };
  }

