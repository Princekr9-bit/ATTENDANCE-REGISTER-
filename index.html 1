  async function aiSendMessage(){
    const inputEl = document.getElementById('aiInput');
    const msg = inputEl.value.trim();
    if(!msg) return;
    aiChat.push({role:'user', text:msg});
    save(K.aiChat, aiChat);
    inputEl.value = '';
    renderAiChatBox();
    const typingHtml = `<div id="aiTyping" style="text-align:left;margin-bottom:10px;"><span style="display:inline-block;background:#fff;border:1px solid #e2e8f0;color:var(--ink-soft);padding:10px 14px;border-radius:14px 14px 14px 2px;">⏳ Soch raha hoon...</span></div>`;
    const box = document.getElementById('aiChatBox');
    if(box) box.insertAdjacentHTML('beforeend', typingHtml);
    if(box) box.scrollTop = box.scrollHeight;
    try{
      const myKey = localStorage.getItem('nm_gemini_key') || '';
      const ctx = buildAiContext();
      const resp = await fetch('/api/ai-assistant', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ message: msg, context: ctx, apiKey: myKey || undefined })
      });
      const data = await resp.json();
      if(!resp.ok) throw new Error(data.error || t('err_request_failed'));
      let replyLines = [];
      if(data.reply) replyLines.push(data.reply.trim());
      (data.actions || []).forEach(action=>{
        const result = executeAiAction(action, ctx.workers);
        replyLines.push(result.msg);
      });
      const finalReply = replyLines.filter(Boolean).join('\n') || t('msg_ho_gaya_fallback');
      aiChat.push({role:'assistant', text: finalReply});
      save(K.aiChat, aiChat);
    }catch(e){
      const busy = /quota|rate|limit|429/i.test(e.message||'');
      const msgText = busy
        ? t('msg_ai_busy')
        : ('❌ Error: '+e.message+t('ai_net_retry'));
      aiChat.push({role:'assistant', text: msgText});
      save(K.aiChat, aiChat);
    }
    renderAiChatBox();
    render();
  }

  function runGlobalSearch(q){
