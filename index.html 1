        return `<div class="list-row" data-selectpay="adv|${a.id}" style="cursor:pointer;"><div><div class="l1">${dispDate(a.date)}</div><div class="l2">${a.note||''}</div></div><div style="text-align:right;"><div class="amt-out">${rupee(a.amount)}</div>${isSel?`<div style="margin-top:4px;">${iconActionsHtml('data-editpay','adv|'+a.id,'data-delpay','adv|'+a.id)}</div>`:''}</div></div>`;
