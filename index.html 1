  function checkAttendanceReminder(){
    if(!('Notification' in window)) return;
    if(Notification.permission!=='granted') return;
    if(getNotifPrefs().attendance===false) return;
    if(new Date().getHours() < 18) return; // evening only
    const today = todayStr();
    if(localStorage.getItem('nm_att_reminded_'+today)==='1') return;
    const anyMarked = attendance.some(a=>a.date===today) || supAttendance.some(a=>a.date===today);
