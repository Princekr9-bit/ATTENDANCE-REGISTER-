    document.querySelectorAll('[data-supmark]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [sid,status] = el.dataset.supmark.split('|');
        if(isAttLocked(sid, 'supervisor', date)) return;
        const idx = supAttendance.findIndex(a=>a.date===date && a.supId===sid);
        if(idx>-1 && supAttendance[idx].status===status){ supAttendance.splice(idx,1); unlockAttendance(sid, 'supervisor', date); }
        else if(idx>-1){ supAttendance[idx].status=status; lockAttendance(sid, 'supervisor', date); }
        else { supAttendance.push({id:uid(), date, supId:sid, status}); lockAttendance(sid, 'supervisor', date); }
        save(K.supAttendance, supAttendance);
        render();
      });
    });
    document.querySelectorAll('[data-guesttap]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const key = el.dataset.guesttap;
        state._guestOpenId = (state._guestOpenId===key) ? null : key;
        render();
      });
    });
    document.querySelectorAll('[data-editguest]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [kind,wid] = el.dataset.editguest.split('|');
        goTo('addPerson', kind+'|'+wid);
      });
    });
    document.querySelectorAll('[data-delguest]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [kind,wid] = el.dataset.delguest.split('|');
        showConfirmModal(t('msg_del_outside_worker'), ()=>{
          if(kind==='majdoor'){ majdoor = majdoor.filter(p=>p.id!==wid); save(K.majdoor, majdoor); }
          else if(kind==='mistri'){ mistri = mistri.filter(p=>p.id!==wid); save(K.mistri, mistri); }
          else if(kind==='driver'){ driver = driver.filter(p=>p.id!==wid); save(K.driver, driver); }
          attendance = attendance.filter(a=>a.workerId!==wid);
          wagePayments = wagePayments.filter(w=>w.workerId!==wid);
          advances = advances.filter(a=>a.workerId!==wid);
          save(K.attendance, attendance);
          save(K.wagePayments, wagePayments);
          save(K.advances, advances);
          render();
        }, t('delete_word'));
      });
    });
    const qg = document.getElementById('quickAddGuest');
    if(qg) qg.addEventListener('click', ()=>{
      const activeKind = (state._attTab==='mistri'||state._attTab==='driver') ? state._attTab : 'majdoor';
      const name = prompt(t('ph_worker_name_prompt'));
      if(!name || !name.trim()) return;
      const rateStr = prompt(t('ph_daily_wage_prompt'),'500');
      const rate = parseFloat(rateStr)||0;
      const obj = {id:uid(), name:name.trim(), address:'', phone:'', photo:'', rate, isGuest:true, guestDate:date};
      if(activeKind==='majdoor'){ majdoor.push(obj); save(K.majdoor,majdoor); }
      else if(activeKind==='driver'){ driver.push(obj); save(K.driver,driver); }
      else { mistri.push(obj); save(K.mistri,mistri); }
      render();
    });
    document.querySelectorAll('[data-drvnotesave]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const driverId = el.dataset.drvnotesave;
        const textEl = document.querySelector(`.drv-note-input[data-drvnote="${driverId}"]`);
        const noteText = textEl.value.trim();
        const idx = driverNotes.findIndex(n=>n.driverId===driverId && n.date===date);
        if(!noteText){
          if(idx>-1){ driverNotes.splice(idx,1); save(K.driverNotes, driverNotes); render(); }
          return;
        }
        if(idx>-1){ driverNotes[idx].note = noteText; }
        else { driverNotes.push({id:uid(), driverId, date, note:noteText}); }
        save(K.driverNotes, driverNotes);
        render();
      });
    });
    const toggleDrvCompBtn = document.getElementById('toggleDrvComp');
    if(toggleDrvCompBtn) toggleDrvCompBtn.addEventListener('click', ()=>{
      state._drvCompOpen = !state._drvCompOpen;
      render();
    });
    const drvCompDriverEl = document.getElementById('drvCompDriver');
    if(drvCompDriverEl) drvCompDriverEl.addEventListener('change', function(){ state._drvCompDriverId = this.value; render(); });
    const drvCompOtherNameEl = document.getElementById('drvCompOtherName');
    if(drvCompOtherNameEl) drvCompOtherNameEl.addEventListener('input', function(){ state._drvCompOtherName = this.value; });
    const drvCompKindEl = document.getElementById('drvCompKind');
    if(drvCompKindEl) drvCompKindEl.addEventListener('change', function(){ state._drvCompKind = this.value; render(); });
    const drvCompSearchEl = document.getElementById('drvCompSearch');
    if(drvCompSearchEl) drvCompSearchEl.addEventListener('input', function(){
      state._drvCompSearch = this.value; render();
      const el = document.getElementById('drvCompSearch');
      if(el){ el.focus(); el.selectionStart = el.selectionEnd = el.value.length; }
    });
    document.querySelectorAll('[data-drvcomppick]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const workerId = el.dataset.drvcomppick;
        const compKind = state._drvCompKind || 'majdoor';
        const driverSelEl = document.getElementById('drvCompDriver');
        const driverId = driverSelEl ? driverSelEl.value : (driver[0] ? driver[0].id : null);
        if(!driverId){ showInfoModal(t('msg_add_driver_first')); return; }
        let withDriverId = null, withDriverName = null;
        if(driverId==='__other__'){
          const otherName = (document.getElementById('drvCompOtherName')||{}).value?.trim();
          if(!otherName){ showInfoModal(t('msg_who_driving')); return; }
          withDriverName = otherName;
        } else {
          withDriverId = driverId;
        }
        const already = attendance.find(a=>a.date===date && a.workerId===workerId && a.workerType===compKind);
        if(already){ showInfoModal(t('msg_att_already')); return; }
        attendance.push({id:uid(), date, siteId:null, workerId, workerType:compKind, status:'P', withDriverId, withDriverName});
        save(K.attendance, attendance);
        state._drvCompOpen = false;
        state._drvCompSearch = '';
        state._drvCompDriverId = null;
        state._drvCompOtherName = '';
        render();
      });
    });
    document.querySelectorAll('[data-drvcompmark]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [recId,status] = el.dataset.drvcompmark.split('|');
        const idx = attendance.findIndex(a=>a.id===recId);
        if(idx<0) return;
        const rec = attendance[idx];
        if(isAttLocked(rec.workerId, rec.workerType, rec.date)) return;
        if(rec.status===status){ rec.status='A'; unlockAttendance(rec.workerId, rec.workerType, rec.date); }
        else { rec.status=status; lockAttendance(rec.workerId, rec.workerType, rec.date); }
        save(K.attendance, attendance);
        render();
      });
    });
    document.querySelectorAll('[data-petrolsave]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const supId = el.dataset.petrolsave;
        const amt = parseFloat(document.getElementById('petrolAmt_'+supId).value)||0;
        transactions = transactions.filter(t=>!(t.category==='petrol' && t.supId===supId && t.date===date));
        if(amt>0){
          const sp = supervisor.find(s=>s.id===supId);
          transactions.push({id:uid(), siteId:null, category:'petrol', supId, date, type:'expense', amount:amt, reason:'Petrol - '+(sp?sp.name:'')});
        }
        save(K.transactions, transactions);
        state._petrolEditId = null;
        render();
      });
    });
    document.querySelectorAll('[data-supcardedit]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const sid = el.dataset.supcardedit;
        if(isAttLocked(sid,'supervisor',date)){
          unlockAttendance(sid, 'supervisor', date);
          clearPayResolved(sid, 'supervisor', date);
        }
        const pt = transactions.find(t=>t.category==='petrol' && t.supId===sid && t.date===date);
        if(pt) state._petrolEditId = pt.id;
        state._attEditOpen = null;
        render();
      });
    });
    document.querySelectorAll('[data-petroleditopen]').forEach(el=>{
      el.addEventListener('click', ()=>{ state._petrolEditId = el.dataset.petroleditopen; render(); });
    });
    document.querySelectorAll('[data-petroldel]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const [txId] = el.dataset.petroldel.split('|');
        showConfirmModal(t('msg_del_petrol_entry'), ()=>{
          transactions = transactions.filter(t=>t.id!==txId);
          save(K.transactions, transactions);
          state._petrolEditId = null;
          state._attEditOpen = null;
          render();
        });
      });
    });
    document.querySelectorAll('[data-editallcomp]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [kind,wid] = el.dataset.editallcomp.split('|');
        unlockAttendance(wid, kind, date);
        clearPayResolved(wid, kind, date);
        state._attEditOpen = null;
        render();
      });
    });
    document.querySelectorAll('[data-drvcompnotesave]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const workerId = el.dataset.drvcompnotesave;
        const textEl = document.querySelector(`.drv-comp-note-input[data-drvcompnote="${workerId}"]`);
        const noteText = textEl.value.trim();
        const idx = companionNotes.findIndex(n=>n.workerId===workerId && n.date===date);
        if(!noteText){
          if(idx>-1){ companionNotes.splice(idx,1); save(K.companionNotes, companionNotes); render(); }
          return;
        }
        if(idx>-1){ companionNotes[idx].note = noteText; }
        else { companionNotes.push({id:uid(), workerId, date, note:noteText}); }
        save(K.companionNotes, companionNotes);
        render();
      });
    });
    document.querySelectorAll('[data-deldrvcomp]').forEach(el=>{
      el.addEventListener('click', ()=>{
        showConfirmModal(t('msg_remove_today'), ()=>{
          attendance = attendance.filter(a=>a.id!==el.dataset.deldrvcomp);
          save(K.attendance, attendance);
          render();
        }, t('remove_word'));
      });
    });
  }

  // ===================== SALARY / PAYMENTS =====================
  function storeForKind(kind){
    if(kind==='supervisor') return supervisor;
    if(kind==='majdoor') return majdoor;
    if(kind==='mistri') return mistri;
    if(kind==='driver') return driver;
    return [];
  }

  function renderSalary(){
    setTopbar(t('payments_title'), true);
    const tab = state._salTab || 'wage';
    let html = `<div class="tabs">
      <div class="tab ${tab==='wage'?'active':''}" data-saltab="wage">${t('work_payment_tab')}</div>
      <div class="tab ${tab==='adv'?'active':''}" data-saltab="adv">${t('advance_tab')}</div>
      <div class="tab ${tab==='sup'?'active':''}" data-saltab="sup">${t('supervisor_salary_tab')}</div>
    </div>`;

    if(tab==='wage'){
      const wageType = state._wageType || 'majdoor';
      const wageQ = (state._wageSearch||'').trim().toLowerCase();
      const wageDate = state._wageDate || todayStr();
      state._wageDate = wageDate;
      let typeList = storeForKind(wageType).filter(w=>!w.leftCompany).filter(w=>!w.isGuest || w.guestDate===wageDate).filter(w=>!wageQ || w.name.toLowerCase().includes(wageQ));
      if(wageType==='majdoor' || wageType==='mistri'){
        function priority(w){
          const attended = isAttendedToday(w.id, wageType, wageDate);
          const paid = wasPaidToday(w.id, wageType, wageDate);
          if(attended && !paid) return 0;
          if(attended && paid) return 1;
          return 2;
        }
        typeList = [...typeList].sort((a,b)=>priority(a)-priority(b));
      }
      if(majdoor.length===0 && mistri.length===0 && driver.length===0){
        html += `<div class="empty-state"><div class="display">Please add labourers/masons/drivers first</div></div>`;
      } else {
        html += `<div class="form-box">
          <label>${t('type_label')}</label>
          <select id="wageTypeSel" class="plain" style="width:100%;">
            <option value="majdoor" ${wageType==='majdoor'?'selected':''}>${t('labourer_single')}</option>
            <option value="mistri" ${wageType==='mistri'?'selected':''}>${t('mason_single')}</option>
            <option value="driver" ${wageType==='driver'?'selected':''}>${t('driver_single')}</option>
          </select>
          <label>${t('search_name')}</label>
          ${searchBarHtml('wageSearch', '🔍 Type a name', state._wageSearch)}
          <label>${t('who_paid')}</label>
          ${(()=>{
            if(!typeList.length) return `<div class="meta" style="color:var(--ink-soft);margin-bottom:10px;">No match</div>`;
            const validKeys = typeList.map(w=>wageType+'|'+w.id);
            let selected = state._wageSelectedWorker;
            if(!selected || !validKeys.includes(selected)) selected = validKeys[0];
            state._wageSelectedWorker = selected;
            const selectedW = typeList.find(w=>wageType+'|'+w.id===selected);
            const selPaidToday = wasPaidToday(selectedW.id, wageType, wageDate);
            const selAttended = (wageType==='majdoor'||wageType==='mistri') && isAttendedToday(selectedW.id, wageType, wageDate);
            const isOpen = !!state._wagePickerOpen;
            let out = `<div class="worker-pick-collapsed" id="wagePickToggle">${selAttended?`<span class="worker-dot ${selPaidToday?'paid':''}"></span>`:'<span style="width:8px;"></span>'}<span>${selectedW.name}</span><span class="chev">${isOpen?'▲':'▼'}</span></div>`;
            if(isOpen){
              out += `<div class="worker-pick-list">${typeList.map(w=>{
                const key = wageType+'|'+w.id;
                const attendedToday = (wageType==='majdoor'||wageType==='mistri') && isAttendedToday(w.id, wageType, wageDate);
                const paidToday = wasPaidToday(w.id, wageType, wageDate);
                return `<div class="worker-pick-row ${key===selected?'picked':''}" data-pickworker="${key}">${attendedToday?`<span class="worker-dot ${paidToday?'paid':''}"></span>`:'<span style="width:8px;"></span>'}<span>${w.name}</span></div>`;
              }).join('')}</div>`;
            }
            return out;
          })()}
          <label>${t('date_label')}</label>
          <input type="date" id="wageDate" value="${wageDate}">
          <label>${t('amount_paid')} (₹)</label>
          <input type="number" id="wageAmt" placeholder="e.g. 3500">
          <label>${t('notes_optional')}</label>
          <textarea id="wageNote" rows="2" placeholder="e.g. Payment for last 7 days"></textarea>
          <button class="save-btn" id="wageSave">${t('record_payment')}</button>
        </div>`;
      }
      html += `<div class="section-title">${t('recent_payments')} (${dispDate(wageDate)})</div>`;
      const recent = [...wagePayments].filter(w=>w.date===wageDate).sort((a,b)=>b.date.localeCompare(a.date));
      html += recent.length ? recent.map(w=>{
        const p = storeForKind(w.workerType).find(m=>m.id===w.workerId);
        if(state._editPay && state._editPay.type==='wage' && state._editPay.id===w.id){
          return `<div class="form-box" style="margin-bottom:10px;">
            <label>${t('date_label')}</label><input type="date" id="editPayDate" value="${w.date}">
            <label>${t('amount')} (₹)</label><input type="number" id="editPayAmt" value="${w.amount}">
            <label>${t('notes_title')}</label><input type="text" id="editPayNote" value="${w.note||''}">
            <div class="row2" style="margin-top:8px;">
              <button class="save-btn" id="editPaySave" style="margin:0;">${t('save')}</button>
              <button class="link-btn" id="editPayCancel" style="margin:0;">${t('cancel_word')}</button>
            </div>
          </div>`;
        }
        const isSelected = state._selectedPay && state._selectedPay.type==='wage' && state._selectedPay.id===w.id;
        const kindLbl = WORKER_LABEL[w.workerType] || w.workerType;
        return `<div class="list-row" data-selectpay="wage|${w.id}" style="cursor:pointer;"><div><div class="l1">${p?p.name:'—'}</div><div class="l2">${dispDate(w.date)} · ${kindLbl}${w.note?' · '+w.note:''}</div></div><div style="text-align:right;"><div class="amt-out">${rupee(w.amount)}</div>${isSelected?`<div style="margin-top:4px;display:flex;gap:6px;justify-content:flex-end;"><button type="button" class="icon-btn edit" data-receipt="wage|${w.id}" title="${t('tooltip_download_receipt')}" style="background:linear-gradient(145deg,rgba(46,139,87,0.2),rgba(46,139,87,0.08));color:var(--green);">🧾</button>${iconActionsHtml('data-editpay','wage|'+w.id,'data-delpay','wage|'+w.id)}</div>`:''}</div></div>`;
      }).join('') : `<div class="meta" style="color:var(--ink-soft);">No payment recorded yet</div>`;

    } else if(tab==='adv'){
      const advType = state._advType || 'majdoor';
      const advQ = (state._advSearch||'').trim().toLowerCase();
      const advList = storeForKind(advType).filter(w=>!w.leftCompany).filter(w=>!advQ || w.name.toLowerCase().includes(advQ));
      const advDate = state._advDate || todayStr();
      state._advDate = advDate;
      html += `<div class="form-box">
        <label>${t('lbl_who_advance')}</label>
        <select id="advTypeSel" class="plain" style="width:100%;">
          <option value="majdoor" ${advType==='majdoor'?'selected':''}>${t('labourer_single')}</option>
          <option value="mistri" ${advType==='mistri'?'selected':''}>${t('mason_single')}</option>
          <option value="driver" ${advType==='driver'?'selected':''}>${t('driver_single')}</option>
          <option value="supervisor" ${advType==='supervisor'?'selected':''}>${t('supervisor_single')}</option>
        </select>
        <label>${t('search_name')}</label>
        ${searchBarHtml('advSearch', '🔍 Type a name', state._advSearch)}
        <label>${t('lbl_select_name')}</label>
        ${(()=>{
          if(!advList.length) return `<div class="meta" style="color:var(--ink-soft);margin-bottom:10px;">No match</div>`;
          const validKeys = advList.map(w=>advType+'|'+w.id);
          let selected = state._advSelectedWorker;
          if(!selected || !validKeys.includes(selected)) selected = validKeys[0];
          state._advSelectedWorker = selected;
          const selectedW = advList.find(w=>advType+'|'+w.id===selected);
          const isOpen = !!state._advPickerOpen;
          let out = `<div class="worker-pick-collapsed" id="advPickToggle"><span>${selectedW.name}</span><span class="chev">${isOpen?'▲':'▼'}</span></div>`;
          if(isOpen){
            out += `<div class="worker-pick-list">${advList.map(w=>{
              const key = advType+'|'+w.id;
              return `<div class="worker-pick-row ${key===selected?'picked':''}" data-pickadvworker="${key}"><span>${w.name}</span></div>`;
            }).join('')}</div>`;
          }
          return out;
        })()}
        <label>Date</label>
        <input type="date" id="advDate" value="${advDate}">
        <label>${t('amount')} (₹)</label>
        <input type="number" id="advAmt" placeholder="e.g. 1000">
        <label>${t('notes_optional')}</label>
        <textarea id="advNote" rows="2" placeholder="e.g. For household expense"></textarea>
        <button class="save-btn" id="advSave">${t('btn_record_advance')}</button>
      </div>`;
      html += `<div class="section-title">Recent Advances (${dispDate(advDate)})</div>`;
      const recent = [...advances].filter(a=>a.date===advDate).sort((a,b)=>b.date.localeCompare(a.date));
      html += recent.length ? recent.map(a=>{
        const w = storeForKind(a.workerType).find(m=>m.id===a.workerId);
        const kindLbl = a.workerType==='supervisor'?'Supervisor':WORKER_LABEL[a.workerType];
        if(state._editPay && state._editPay.type==='adv' && state._editPay.id===a.id){
          return `<div class="form-box" style="margin-bottom:10px;">
            <label>${t('date_label')}</label><input type="date" id="editPayDate" value="${a.date}">
            <label>${t('amount')} (₹)</label><input type="number" id="editPayAmt" value="${a.amount}">
            <label>${t('notes_title')}</label><input type="text" id="editPayNote" value="${a.note||''}">
            <div class="row2" style="margin-top:8px;">
              <button class="save-btn" id="editPaySave" style="margin:0;">${t('save')}</button>
              <button class="link-btn" id="editPayCancel" style="margin:0;">${t('cancel_word')}</button>
            </div>
          </div>`;
        }
        const isSelectedAdv = state._selectedPay && state._selectedPay.type==='adv' && state._selectedPay.id===a.id;
        return `<div class="list-row" data-selectpay="adv|${a.id}" style="cursor:pointer;"><div><div class="l1">${w?w.name:'—'} <span class="badge">${kindLbl}</span></div><div class="l2">${dispDate(a.date)}${a.note?' · '+a.note:''}</div></div><div style="text-align:right;"><div class="amt-out">${rupee(a.amount)}</div>${isSelectedAdv?`<div style="margin-top:4px;">${iconActionsHtml('data-editpay','adv|'+a.id,'data-delpay','adv|'+a.id)}</div>`:''}</div></div>`;
      }).join('') : `<div class="meta" style="color:var(--ink-soft);">No advance given yet</div>`;

    } else {
      const supDate = state._supDate || todayStr();
      state._supDate = supDate;
      if(supervisor.length===0){
        html += `<div class="empty-state"><div class="display">Please add a supervisor first</div></div>`;
      } else {
        html += `<div class="form-box">
          <label>${t('lbl_select_supervisor')}</label>
          <select id="supSel" class="plain" style="width:100%;">
            ${supervisor.filter(s=>!s.leftCompany).map(s=>`<option value="${s.id}" ${state._supPreselect===s.id?'selected':''}>${s.name}</option>`).join('')}
          </select>
          <label>Date</label>
          <input type="date" id="supDate" value="${supDate}">
          <label>${t('lbl_salary_amount')}</label>
          <input type="number" id="supAmt" placeholder="e.g. 15000">
          <label>${t('notes_optional')}</label>
          <textarea id="supNote" rows="2" placeholder="Notes"></textarea>
          <button class="save-btn" id="supSave">${t('btn_record_salary')}</button>
        </div>`;
      }
      html += `<div class="section-title">Recent Salary Payments (${dispDate(supDate)})</div>`;
      const recent = [...supPayments].filter(pm=>pm.date===supDate).sort((a,b)=>b.date.localeCompare(a.date));
      html += recent.length ? recent.map(pm=>{
        const s = supervisor.find(x=>x.id===pm.supId);
        if(state._editPay && state._editPay.type==='sup' && state._editPay.id===pm.id){
          return `<div class="form-box" style="margin-bottom:10px;">
            <label>${t('date_label')}</label><input type="date" id="editPayDate" value="${pm.date}">
            <label>${t('amount')} (₹)</label><input type="number" id="editPayAmt" value="${pm.amount}">
            <label>${t('notes_title')}</label><input type="text" id="editPayNote" value="${pm.note||''}">
            <div class="row2" style="margin-top:8px;">
              <button class="save-btn" id="editPaySave" style="margin:0;">${t('save')}</button>
              <button class="link-btn" id="editPayCancel" style="margin:0;">${t('cancel_word')}</button>
            </div>
          </div>`;
        }
        const isSelectedSup = state._selectedPay && state._selectedPay.type==='sup' && state._selectedPay.id===pm.id;
        return `<div class="list-row" data-selectpay="sup|${pm.id}" style="cursor:pointer;"><div><div class="l1">${s?s.name:'—'}</div><div class="l2">${dispDate(pm.date)}${pm.note?' · '+pm.note:''}</div></div><div style="text-align:right;"><div class="amt-out">${rupee(pm.amount)}</div>${isSelectedSup?`<div style="margin-top:4px;">${iconActionsHtml('data-editpay','sup|'+pm.id,'data-delpay','sup|'+pm.id)}</div>`:''}</div></div>`;
      }).join('') : `<div class="meta" style="color:var(--ink-soft);">No salary recorded yet</div>`;
    }

    app.innerHTML = html;
