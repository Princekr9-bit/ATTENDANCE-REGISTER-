    document.querySelectorAll('[data-advquick]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [kind,wid] = el.dataset.advquick.split('|');
        state._salTab = 'adv';
        state._advType = kind;
        state._advDate = date;
        state._advSearch = '';
        state._advSelectedWorker = kind+'|'+wid;
        state._advPickerOpen = false;
        markPayResolved(wid, kind, date);
        goTo('salary');
      });
    });
    document.querySelectorAll('[data-notpay]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [kind,wid] = el.dataset.notpay.split('|');
        markPayResolved(wid, kind, date);
        render();
      });
    });
    document.querySelectorAll('[data-unresolve]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [kind,wid] = el.dataset.unresolve.split('|');
