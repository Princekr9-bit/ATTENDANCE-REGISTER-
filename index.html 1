  function renderNotes(){
    setTopbar(t('notes_title'), true);
    const now = new Date();
    const nowStr = nowLocalKey();
    const permState = ('Notification' in window) ? Notification.permission : 'unsupported';
    const permLabel = permState==='granted' ? '✅ Notifications are ON' : permState==='denied' ? '🚫 Notifications blocked (check browser site settings)' : permState==='unsupported' ? '⚠️ Notifications not supported on this browser' : '🔔 Notifications not enabled yet';
    let html = permState==='default' ? `<div class="form-box" style="margin-bottom:12px;">
      <button class="btn-outline" id="enableNotifBtn" style="margin:0;">${t('btn_enable_notif')}</button>
    </div>` : '';
    html += `<div class="form-box">
      <label>${t('write_note')}</label>
      <textarea id="noteText" rows="3" placeholder="${t('ph_type_note')}"></textarea>
      <label>${t('remind_optional')}</label>
      <input type="date" id="noteDate">
      <label>${t('remind_time_optional')}</label>
      <input type="time" id="noteTime" value="09:00">
      <button class="save-btn" id="noteSave">${t('save_note')}</button>
    </div>`;
    html += `<div class="section-title">${t('your_notes')}</div>`;
    const nowVal = nowStr;
    const sorted = [...notes].sort((a,b)=>{
      const ak = a.reminderDate ? a.reminderDate+'T'+(a.reminderTime||'00:00') : '';
      const bk = b.reminderDate ? b.reminderDate+'T'+(b.reminderTime||'00:00') : '';
      if(ak && bk) return ak.localeCompare(bk);
      if(ak) return -1;
      if(bk) return 1;
      return b.createdAt.localeCompare(a.createdAt);
    });
    if(sorted.length===0){
      html += `<div class="meta" style="color:var(--ink-soft);">${t('no_notes_yet')}</div>`;
    } else {
      html += sorted.map(n=>{
        const remKey = n.reminderDate ? n.reminderDate+'T'+(n.reminderTime||'00:00') : null;
        const isDue = remKey && remKey<=nowVal;
        const remLabel = n.reminderDate ? dispDate(n.reminderDate) + (n.reminderTime ? ' at '+n.reminderTime : '') : '';
        return `<div class="note-card ${isDue?'due':''}">
          <div class="ntext">${escapeHtml(n.text)}</div>
          <div class="nmeta">
            <span>${n.reminderDate ? (isDue?'⏰ Due: ':'📅 Reminder: ')+remLabel : t('no_reminder')}</span>
            <button class="ndel" data-delnote="${n.id}">${t('delete_word')}</button>
          </div>
        </div>`;
      }).join('');
    }
    app.innerHTML = html;
    const enableBtn = document.getElementById('enableNotifBtn');
    if(enableBtn) enableBtn.addEventListener('click', ()=>{
      Notification.requestPermission().then(()=>render());
    });
    document.getElementById('noteSave').addEventListener('click', ()=>{
      const text = document.getElementById('noteText').value.trim();
      if(!text){ showInfoModal(t('msg_write_something')); return; }
      const reminderDate = document.getElementById('noteDate').value || null;
      const reminderTime = document.getElementById('noteTime').value || '09:00';
      notes.push({id:uid(), text, reminderDate, reminderTime, createdAt:new Date().toISOString(), lastNotifiedKey:null});
      save(K.notes, notes);
      if(reminderDate){
        if('Notification' in window && Notification.permission==='default'){
          Notification.requestPermission().then(()=>{ if(swRegistration) initFirebaseMessaging(swRegistration); });
        }
        const sendAtDate = new Date(reminderDate+'T'+reminderTime+':00');
        scheduleServerReminder(t('notif_reminder_title2'), text.slice(0,120), sendAtDate);
      }
      render();
    });
    document.querySelectorAll('[data-delnote]').forEach(el=>{
      el.addEventListener('click', ()=>{
        notes = notes.filter(n=>n.id!==el.dataset.delnote);
        save(K.notes, notes);
        render();
      });
    });
  }

