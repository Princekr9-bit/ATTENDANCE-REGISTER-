  function buildAiContext(){
    const workers = [];
    WORKER_STORE.majdoor().filter(w=>!w.leftCompany).forEach(w=>workers.push({id:w.id, name:w.name, kind:'majdoor'}));
    WORKER_STORE.mistri().filter(w=>!w.leftCompany).forEach(w=>{ if(!workers.some(x=>x.id===w.id)) workers.push({id:w.id, name:w.name, kind:'mistri'}); });
    driver.filter(w=>!w.leftCompany).forEach(w=>workers.push({id:w.id, name:w.name, kind:'driver'}));
    supervisor.filter(w=>!w.leftCompany).forEach(w=>workers.push({id:w.id, name:w.name, kind:'supervisor'}));
    const siteList = sites.map(s=>({id:s.id, name:s.name}));
    return { today: todayStr(), workers, sites: siteList };
  }

  function executeAiAction(action, ctxWorkers){
    const info = ctxWorkers.find(w=>w.id===action.input.workerId || w.id===action.input.driverId);
    const kind = info ? info.kind : null;
    const name = info ? info.name : t('lbl_unknown_word');
    try{
      if(action.name==='mark_attendance'){
        const wid = action.input.workerId;
        const status = action.input.status;
        const date = action.input.date || todayStr();
        if(!kind) return { ok:false, msg:`${t('ai_worker_not_found_att')}` };
        if(kind==='supervisor'){
          const idx = supAttendance.findIndex(a=>a.date===date && a.supId===wid);
          if(idx>-1) supAttendance[idx].status = status;
          else supAttendance.push({id:uid(), date, supId:wid, status});
          save(K.supAttendance, supAttendance);
          lockAttendance(wid, 'supervisor', date);
        } else if(kind==='driver'){
          const idx = attendance.findIndex(a=>a.date===date && a.workerId===wid && a.workerType==='driver');
          if(idx>-1) attendance[idx].status = status;
          else attendance.push({id:uid(), date, siteId:null, workerId:wid, workerType:'driver', status});
          save(K.attendance, attendance);
          lockAttendance(wid, 'driver', date);
        } else {
          const siteId = action.input.siteId || null;
          if((status==='P'||status==='H') && !siteId){
            return { ok:false, msg:`❌ ${name} ka attendance ke liye site batao.` };
          }
          const idx = attendance.findIndex(a=>a.date===date && a.workerId===wid && a.workerType===kind);
          if(idx>-1){ attendance[idx].status = status; if(siteId) attendance[idx].siteId = siteId; }
          else attendance.push({id:uid(), date, siteId, workerId:wid, workerType:kind, status});
          save(K.attendance, attendance);
          lockAttendance(wid, kind, date);
        }
        const stLbl = status==='P'?t('full_day'):status==='H'?t('half_day'):t('absent');
        return { ok:true, msg:`✅ ${name} — ${stLbl} (${dispDate(date)}) ${t('ai_att_marked')}` };
      }
      if(action.name==='record_payment'){
        const wid = action.input.workerId;
        const date = action.input.date || todayStr();
        const amount = action.input.amount;
        if(!kind) return { ok:false, msg:`${t('ai_worker_not_found_pay')}` };
        if(kind==='supervisor'){
          supPayments.push({id:uid(), supId:wid, date, amount, note:action.input.note||''});
          save(K.supPayments, supPayments);
        } else {
          wagePayments.push({id:uid(), workerId:wid, workerType:kind, date, amount, note:action.input.note||''});
          save(K.wagePayments, wagePayments);
        }
        markPayResolved(wid, kind, date);
        return { ok:true, msg:`✅ ${name} ko ₹${amount} ${t('ai_payment_done')} (${dispDate(date)}).` };
      }
      if(action.name==='record_advance'){
        const wid = action.input.workerId;
        const date = action.input.date || todayStr();
        const amount = action.input.amount;
        if(!kind) return { ok:false, msg:`${t('ai_worker_not_found_adv')}` };
        advances.push({id:uid(), workerId:wid, workerType:kind, date, amount, note:action.input.note||''});
        save(K.advances, advances);
        if(kind==='majdoor'||kind==='mistri') markPayResolved(wid, kind, date);
        return { ok:true, msg:`✅ ${name} ko ₹${amount} ${t('ai_advance_done')} (${dispDate(date)}).` };
      }
      if(action.name==='add_site_task'){
        const task = action.input.task;
        const date = action.input.date || todayStr();
        const siteId = action.input.siteId || null;
        todos.push({id:uid(), date, task, done:false, siteId, reason:''});
        save(K.todos, todos);
        const site = siteId ? sites.find(s=>s.id===siteId) : null;
        return { ok:true, msg:`${t('ai_site_task_added')} (${dispDate(date)})${site?' — '+site.name:''}: ${task}` };
      }
      if(action.name==='add_personal_todo'){
        const task = action.input.task;
        const date = action.input.date || todayStr();
        personalTodos.push({id:uid(), date, task, done:false});
        save(K.personalTodos, personalTodos);
        return { ok:true, msg:`${t('ai_todo_added')} (${dispDate(date)}): ${task}` };
      }
      if(action.name==='add_driver_note'){
        const did = action.input.driverId;
        const date = action.input.date || todayStr();
        const note = action.input.note;
        const idx = driverNotes.findIndex(n=>n.driverId===did && n.date===date);
        if(idx>-1) driverNotes[idx].note = note;
        else driverNotes.push({id:uid(), driverId:did, date, note});
        save(K.driverNotes, driverNotes);
        return { ok:true, msg:`✅ ${name} ${t('ai_note_saved')}` };
      }
      return { ok:false, msg:t('ai_action_unclear') };
    }catch(e){
      return { ok:false, msg:'❌ Error: '+e.message };
    }
  }

