<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Attendance Register</title>
<link rel="manifest" href="./manifest.json">
<script src="https://www.gstatic.com/firebasejs/12.15.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/12.15.0/firebase-messaging-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/12.15.0/firebase-firestore-compat.js"></script>
<meta name="theme-color" content="#152A52">
<link rel="apple-touch-icon" href="./icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F2F3F6; --card:#FFFFFF; --line:#E3E6EC;
    --navy:#152A52; --navy2:#1F3A6E; --orange:#E8622C; --orange-dark:#C94E1E;
    --steel:#8A93A3; --ink:#1B2333; --ink-soft:#616B7C;
    --green:#2E8B57; --green-light:#E4F3EA;
    --amber:#D69F2E; --amber-light:#FBF0DC;
    --red:#C1442D; --red-light:#F5E1DB;
    --shadow:0 2px 0 rgba(21,42,82,0.10);
  }
  body[data-theme="dark"]{
    --bg:#0F1620; --card:#1A2333; --line:#2A3547;
    --navy:#2A5CA8; --navy2:#3A6FC4; --orange:#F0954A; --orange-dark:#E8622C;
    --steel:#8A93A3; --ink:#E7ECF5; --ink-soft:#9AA5B8;
    --green:#4CAF7D; --green-light:#1E3328;
    --amber:#E0B759; --amber-light:#3A331C;
    --red:#E0705A; --red-light:#3A2420;
    --shadow:0 2px 0 rgba(0,0,0,0.25);
    background:var(--bg);color:var(--ink);
  }
  body[data-theme="dark"] input, body[data-theme="dark"] select, body[data-theme="dark"] textarea{background:#1A2333;color:var(--ink);border-color:var(--line);}
  body[data-theme="dark"] .form-box, body[data-theme="dark"] .loc-box{background:var(--card);border-color:var(--line);}
  body[data-theme="dark"] #bottomNav{background:rgba(26,35,51,0.96);border-top-color:#2A3547;}
  body[data-theme="dark"] #topbar{background:linear-gradient(135deg,#152A52,#0b1f3a);}
  body[data-theme="dark"] .confirm-box{background:rgba(26,35,51,0.96);color:var(--ink);}
  body[data-theme="dark"] .confirm-msg{color:var(--ink);}
  body[data-theme="dark"] #aiChatOverlay > div{background:#151E2C;}
  body[data-theme="dark"] .greet-card{background:linear-gradient(135deg,#1A2333,#151E2C);border-color:var(--line);}
  body[data-theme="dark"] .greet-title{color:#fff;}
  body[data-theme="dark"] .stat-card{background:var(--card);}
  body[data-theme="dark"] .stat-num{color:#fff;}
  .chip-filter{flex-shrink:0;padding:7px 14px;border-radius:20px;border:1px solid var(--line);background:#fff;color:var(--ink-soft);font-weight:600;font-size:0.78rem;cursor:pointer;white-space:nowrap;}
  .chip-filter.active{background:var(--navy);border-color:var(--navy);color:#fff;}
  .site-quick-btn{display:inline-flex;align-items:center;gap:5px;padding:6px 12px;border-radius:16px;background:#EEF0F4;color:var(--navy);font-size:0.72rem;font-weight:700;text-decoration:none;}
  .site-quick-btn svg{width:13px;height:13px;}
  body[data-theme="dark"] .tabs{background:#1A2333;}
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--bg);color:var(--ink);font-family:'Mukta',sans-serif;min-height:100vh;padding-bottom:110px;}
  h1,h2,h3,.display{font-family:'Mukta',sans-serif;font-weight:800;}
  button{font-family:'Mukta',sans-serif;}
  img.avatar{width:100%;height:100%;object-fit:cover;border-radius:50%;}
  .avatar-wrap{width:48px;height:48px;border-radius:50%;background:#DDE2EA;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--navy);flex-shrink:0;overflow:hidden;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.15s ease;}
  .avatar-wrap.lg{width:76px;height:76px;font-size:1.5rem;}

  /* ---------- Top bar ---------- */
  #topbar{background:var(--navy);color:#fff;padding:12px 14px;display:flex;align-items:center;gap:10px;position:sticky;top:0;z-index:20;}
  #homeHeaderExtra{position:sticky;top:0;z-index:19;}
  #homeSearchBar::placeholder{color:#AEB9CE;}
  #topbar .back{font-size:1.3rem;cursor:pointer;padding:2px 6px;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  #topbar .back:active{transform:scale(0.85);}
  #topbar .brand{flex:1;display:flex;align-items:center;gap:8px;cursor:pointer;min-width:0;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  #topbar .brand:active{transform:scale(0.98);}
  #topbar .brand:active .avatar-wrap{box-shadow:0 0 0 4px rgba(232,98,44,0.25);}
  #topbar .brand .avatar-wrap{width:42px;height:42px;background:var(--orange);color:#fff;font-size:1.1rem;box-shadow:0 0 0 2px rgba(255,255,255,0.15);}
  #topbar .brand-name{font-weight:700;font-size:1.05rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  #topbar .page-title{font-size:0.72rem;color:#AEB9CE;}
  #menuBtn{background:rgba(255,255,255,0.12);border:none;color:#fff;cursor:pointer;width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background 0.15s ease, transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  #menuBtn:active{transform:scale(0.88);background:rgba(255,255,255,0.22);}
  #menuBtn svg{width:19px;height:19px;}

  /* ---------- Drawer ---------- */
  #overlay{position:fixed;inset:0;background:rgba(0,0,0,0.4);display:none;z-index:590;}
  #overlay.show{display:block;}
  #drawer{position:fixed;top:0;left:-280px;width:264px;height:100%;background:var(--card);z-index:600;transition:left 0.25s ease;box-shadow:4px 0 12px rgba(0,0,0,0.2);overflow-y:auto;padding-bottom:40px;}
  #drawer.show{left:0;}
  #drawer .dhead{background:var(--navy);color:#fff;padding:18px 16px;font-weight:700;}
  #drawer .ditem{padding:14px 16px;border-bottom:1px solid var(--line);cursor:pointer;font-weight:600;display:flex;align-items:center;gap:10px;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1), background 0.15s ease;}
  #drawer .ditem:active{background:var(--bg);transform:scale(0.97);}
  #drawer .ditem:active .demoji{transform:scale(1.15);}
  #drawer .demoji{font-size:1.15rem;display:inline-flex;align-items:center;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1), color 0.15s ease;}
  #drawer .demoji svg{width:19px;height:19px;}

  main{padding:14px 14px 20px;max-width:640px;margin:0 auto;}

  /* ---------- Cards / list ---------- */
  .card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:10px;box-shadow:var(--shadow);display:flex;align-items:center;gap:12px;cursor:pointer;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  .card:active{transform:scale(0.98);}
  .card .info{flex:1;min-width:0;}
  .card .title{font-weight:700;font-size:1rem;}
  .card .meta{font-size:0.78rem;color:var(--ink-soft);}
  .card .chev{color:var(--ink-soft);font-size:1.1rem;}
  .badge{display:inline-block;font-size:0.65rem;background:var(--amber-light);color:var(--amber);border-radius:5px;padding:1px 6px;margin-left:6px;font-weight:700;}

  .fab{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);max-width:600px;width:calc(100% - 28px);background:linear-gradient(135deg,#F0954A,var(--orange));color:#fff;border:none;border-radius:12px;padding:13px;font-weight:800;font-size:1rem;box-shadow:0 8px 20px rgba(232,98,44,0.35);cursor:pointer;z-index:501;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.15s ease;}
  .fab:active{transform:translateX(-50%) scale(0.96);box-shadow:0 4px 12px rgba(232,98,44,0.3);}
  .btn-block{width:100%;background:linear-gradient(135deg,#F0954A,var(--orange));color:#fff;border:none;border-radius:12px;padding:13px;font-weight:800;font-size:1rem;box-shadow:0 8px 20px rgba(232,98,44,0.30);cursor:pointer;margin-bottom:10px;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.15s ease;}
  .btn-block:active{transform:scale(0.97);box-shadow:0 4px 12px rgba(232,98,44,0.25);}
  .btn-outline{width:100%;background:#fff;color:var(--navy);border:1.5px solid var(--navy);border-radius:12px;padding:11px;font-weight:700;font-size:0.95rem;cursor:pointer;margin-bottom:10px;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  .btn-outline:active{transform:scale(0.97);}

  .empty-state{text-align:center;padding:40px 20px;color:var(--ink-soft);}
  .empty-state .display{font-size:1.1rem;margin-bottom:6px;color:var(--ink);}

  /* ---------- Forms ---------- */
  .form-box{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;box-shadow:var(--shadow), 0 0 0 1px rgba(232,98,44,0.03);position:relative;transition:box-shadow 0.2s ease;}
  .form-box:focus-within{box-shadow:var(--shadow), 0 0 0 1px rgba(232,98,44,0.12), 0 0 20px rgba(232,98,44,0.08);}
  label{display:block;font-size:0.8rem;font-weight:600;color:var(--ink-soft);margin:10px 0 4px;}
  label:first-child{margin-top:0;}
  input[type=text],input[type=number],input[type=tel],input[type=date],input[type=month],input[type=password],select,textarea{
    width:100%;padding:11px;border:1.5px solid var(--line);border-radius:7px;font-family:'Mukta',sans-serif;font-size:0.95rem;background:#fff;color:var(--ink);transition:border-color 0.15s ease, box-shadow 0.15s ease;
  }
  input[type=text]:focus,input[type=number]:focus,input[type=tel]:focus,input[type=date]:focus,input[type=month]:focus,input[type=password]:focus,select:focus,textarea:focus{
    outline:none;border-color:var(--orange);box-shadow:0 0 0 3px rgba(232,98,44,0.14);
  }
  input[type=file]{width:100%;padding:8px;border:1.5px dashed var(--line);border-radius:7px;font-size:0.85rem;}
  .photo-preview{width:76px;height:76px;border-radius:50%;object-fit:cover;margin-top:8px;display:none;}
  .row2{display:flex;gap:10px;}
  .row2>*{flex:1;}
  .save-btn{width:100%;background:linear-gradient(135deg,#F0954A,var(--orange));color:#fff;border:none;padding:13px;border-radius:12px;font-weight:800;font-size:1rem;cursor:pointer;box-shadow:0 8px 20px rgba(232,98,44,0.30);margin-top:14px;margin-bottom:20px;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.15s ease;}
  .save-btn:active{transform:scale(0.97);box-shadow:0 4px 12px rgba(232,98,44,0.25);}
  .link-btn{display:inline-flex;align-items:center;gap:6px;background:linear-gradient(145deg, rgba(232,98,44,0.16), rgba(232,98,44,0.06));border:1px solid rgba(255,255,255,0.5);color:var(--red);font-weight:700;font-size:0.85rem;cursor:pointer;padding:9px 16px;border-radius:20px;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);box-shadow:0 2px 6px rgba(11,31,58,0.14), inset 0 1px 1px rgba(255,255,255,0.6);margin-top:8px;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  .link-btn:active{transform:scale(0.94);}
  .worker-pick-list{max-height:260px;overflow-y:auto;border:1.5px solid #e2e8f0;border-radius:10px;margin-top:6px;margin-bottom:10px;}
  .worker-pick-collapsed{display:flex;align-items:center;gap:8px;border:1.5px solid #e2e8f0;border-radius:10px;padding:12px 14px;cursor:pointer;margin-bottom:0;font-size:0.95rem;}
  .worker-pick-collapsed .chev{margin-left:auto;color:var(--ink-soft);font-size:0.75rem;}
  .worker-pick-row{display:flex;align-items:center;gap:8px;padding:11px 14px;cursor:pointer;border-bottom:1px solid #f0f2f6;font-size:0.92rem;}
  .worker-pick-row:last-child{border-bottom:none;}
  .worker-pick-row.picked{background:#FBEDE3;font-weight:700;color:var(--navy);}
  .worker-dot{width:8px;height:8px;border-radius:50%;background:var(--green);flex-shrink:0;box-shadow:0 0 0 2px rgba(90,184,120,0.25);}
  .worker-dot.paid{background:var(--orange);box-shadow:0 0 0 2px rgba(232,148,74,0.25);}
  .pay-tick{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;font-size:0.7rem;font-weight:800;color:#fff;cursor:pointer;margin-left:6px;vertical-align:middle;}
  .pay-tick.yes{background:var(--green);}
  .pay-tick.skip{background:#B5541F;}
  .lock-tag{display:block;font-size:0.72rem;font-weight:700;color:var(--navy);background:#EEF0F4;border-radius:6px;padding:3px 8px;margin-top:4px;cursor:pointer;width:fit-content;}
  .stamp-row.locked .stamp{pointer-events:none;opacity:0.55;}

  /* ---------- Profile header ---------- */
  .profile-head{background:linear-gradient(135deg,#152A52,#0b1f3a);border-radius:20px;padding:22px 18px;box-shadow:0 8px 24px rgba(11,31,58,0.25);display:flex;gap:16px;align-items:center;margin-bottom:16px;position:relative;overflow:hidden;}
  .profile-head::before{content:'';position:absolute;top:-46px;right:-46px;width:150px;height:150px;border-radius:50%;background:rgba(232,98,44,0.14);pointer-events:none;}
  .profile-head .avatar-wrap{box-shadow:0 0 0 3px rgba(255,255,255,0.18);position:relative;z-index:1;}
  .profile-head .pi{position:relative;z-index:1;min-width:0;}
  .profile-head .pi h2{margin:0 0 5px;font-size:1.2rem;color:#fff;}
  .profile-head .pi .meta{font-size:0.8rem;color:#AEB9CE;line-height:1.7;}
  .profile-role-chip{display:inline-block;background:rgba(232,98,44,0.22);border:1px solid rgba(232,98,44,0.4);color:#FFC9A8;font-size:0.66rem;font-weight:800;padding:3px 10px;border-radius:20px;margin-bottom:7px;letter-spacing:0.3px;text-transform:uppercase;}

  .section-title{font-weight:700;font-size:0.95rem;margin:18px 0 8px;color:var(--navy);}

  /* ---------- Attendance stamps ---------- */
  .stamp-row{display:flex;gap:6px;}
  .sup-att-card{flex-direction:column;align-items:stretch;gap:0;}
  .sup-att-row{display:flex;align-items:center;gap:12px;}
  .petrol-inline{margin-top:12px;padding-top:12px;border-top:1px dashed var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px;animation:petrolFadeIn 0.25s ease;}
  .sup-row-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:10px;animation:petrolFadeIn 0.2s cubic-bezier(0.34,1.56,0.64,1);}
  @keyframes petrolFadeIn{from{opacity:0;transform:translateY(-4px);}to{opacity:1;transform:translateY(0);}}
  .petrol-inline-info{display:flex;flex-direction:column;gap:2px;font-size:0.78rem;color:var(--ink-soft);}
  .petrol-inline-info strong{font-size:0.95rem;color:var(--navy);}
  .petrol-inline-edit{flex-direction:column;align-items:stretch;}
  .petrol-inline-edit label{font-size:0.8rem;color:var(--ink-soft);margin-bottom:6px;font-weight:600;}
  .petrol-inline-form{display:flex;gap:8px;}
  .petrol-inline-form input{flex:1;margin:0;}
  .stamp{width:38px;height:38px;border-radius:50%;border:2px dashed transparent;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.8rem;cursor:pointer;background:#EEF0F4;color:var(--ink-soft);}
  .stamp.on-P{background:var(--green-light);color:var(--green);border-color:var(--green);}
  .stamp.on-H{background:var(--amber-light);color:var(--amber);border-color:var(--amber);}
  .stamp.on-A{background:var(--red-light);color:var(--red);border-color:var(--red);}

  .tabs{display:flex;margin-bottom:12px;background:#EEF0F4;border-radius:12px;padding:4px;flex-wrap:wrap;gap:2px;}
  .tab{flex:1;text-align:center;padding:9px 4px;font-weight:700;font-size:0.85rem;color:var(--ink-soft);cursor:pointer;border-radius:9px;min-width:80px;transition:all 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  .tab:active{transform:scale(0.94);}
  .tab.active{color:#fff;background:var(--navy);box-shadow:0 2px 6px rgba(21,42,82,0.3);}

  .list-row{display:flex;justify-content:space-between;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 12px;margin-bottom:6px;font-size:0.88rem;box-shadow:var(--shadow);transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  .list-row .l1{font-weight:600;}
  .list-row .l2{font-size:0.76rem;color:var(--ink-soft);}
  .amt-in{color:var(--green);font-weight:700;}
  .amt-out{color:var(--red);font-weight:700;}

  .summary-bar{background:linear-gradient(160deg,#0b1f3a,#152A52);color:#fff;border-radius:14px;padding:16px 14px;display:flex;justify-content:space-between;gap:8px;margin:14px 0;flex-wrap:wrap;box-shadow:0 6px 16px rgba(11,31,58,0.25);}
  .summary-item{text-align:center;flex:1;min-width:70px;}
  .summary-item .num{font-weight:800;font-size:1.25rem;}
  .summary-item .lbl{font-size:0.66rem;color:#AEB9CE;margin-top:2px;}

  select.plain{background:#fff;border:1.5px solid var(--line);border-radius:7px;padding:9px;font-weight:600;}

  /* ---------- Calendar ---------- */
  .cal-legend{display:flex;gap:14px;flex-wrap:wrap;font-size:0.75rem;color:var(--ink-soft);margin-bottom:8px;}
  .cal-legend span{display:inline-flex;align-items:center;gap:4px;}
  .dot{width:10px;height:10px;border-radius:50%;display:inline-block;}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:6px;}
  .cal-dow{text-align:center;font-size:0.7rem;font-weight:700;color:var(--ink-soft);}
  .cal-day{aspect-ratio:1;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;background:#EEF0F4;color:var(--ink-soft);transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.15s ease;}
  .cal-day.blank{background:transparent;}
  .cal-day.P{background:var(--green);color:#fff;cursor:pointer;}
  .cal-day.H{background:var(--amber);color:#fff;cursor:pointer;}
  .cal-day.A{background:var(--red);color:#fff;cursor:pointer;}
  .cal-day[data-date]:not(.blank):active{transform:scale(0.85);box-shadow:0 0 10px rgba(232,98,44,0.3);}
  .cal-nav{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
  .cal-nav button{background:var(--navy);color:#fff;border:none;border-radius:7px;width:38px;height:38px;font-size:1.1rem;cursor:pointer;flex-shrink:0;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  .cal-nav button:active{transform:scale(0.88);}
  .cal-nav input{flex:1;}
  #dayModalOverlay{position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:60;display:flex;align-items:center;justify-content:center;padding:20px;}
  #dayModalOverlay.hidden{display:none;}
  #dayModalBox{background:#fff;border-radius:12px;padding:20px;max-width:320px;width:100%;text-align:center;}
  #dayModalBox h3{margin:0 0 10px;color:var(--navy);}
  #dayModalBox .drow{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--line);font-size:0.92rem;}
  #dayModalBox .dclose{margin-top:14px;background:var(--orange);color:#fff;border:none;border-radius:8px;padding:10px 20px;font-weight:700;cursor:pointer;}

  /* ---------- Notes ---------- */
  .note-card{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--orange);border-radius:12px;padding:14px;margin-bottom:10px;box-shadow:0 3px 10px rgba(11,31,58,0.06);transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  .note-card:active{transform:scale(0.98);}
  .note-card.due{border-left-color:var(--red);background:linear-gradient(135deg,var(--red-light),#fff);}
  .note-card .ntext{white-space:pre-wrap;font-size:0.92rem;margin-bottom:8px;line-height:1.4;}
  .note-card .nmeta{display:flex;justify-content:space-between;align-items:center;font-size:0.72rem;color:var(--ink-soft);}
  .note-card .ndel{background:rgba(193,68,45,0.10);border:none;color:var(--red);font-weight:700;cursor:pointer;font-size:0.72rem;padding:4px 10px;border-radius:8px;transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  .note-card .ndel:active{transform:scale(0.92);}
  .task-card{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:8px;cursor:pointer;box-shadow:0 2px 6px rgba(11,31,58,0.05);transition:transform 0.15s cubic-bezier(0.34,1.56,0.64,1);}
  .task-card:active{transform:scale(0.98);}
  .task-card.done{background:#F7F9FC;}
  .task-check{width:22px;height:22px;flex-shrink:0;accent-color:var(--orange);cursor:pointer;}
