  function openLocationPicker(initLat, initLng, onSave){
    const overlay = document.getElementById('locPickerOverlay');
    const mapEl = document.getElementById('locMapEl');
    if(!overlay || !mapEl || typeof maplibregl==='undefined'){
      showInfoModal(t('msg_map_load_failed'));
      return;
    }
    overlay.style.display = 'flex';
    const startLat = (typeof initLat==='number') ? initLat : 25.5941;
    const startLng = (typeof initLng==='number') ? initLng : 85.1376;
    if(_locMapInstance){ _locMapInstance.remove(); _locMapInstance = null; }
    const map = new maplibregl.Map({
      container: mapEl,
      style: SATELLITE_STYLE,
      center: [startLng, startLat],
      zoom: (typeof initLat==='number') ? 18 : 12,
      pitch: 0,
      bearing: 0,
      attributionControl: false
    });
    map.touchZoomRotate.enableRotation();
    map.touchPitch.enable();
    map.dragRotate.enable();
    _locMapInstance = map;

    const searchInput = document.getElementById('locSearchInput');
    const resultsBox = document.getElementById('locSearchResults');
    searchInput.value = '';
    resultsBox.style.display = 'none';
    resultsBox.innerHTML = '';
    let searchTimer = null;

    function tryParseCoords(text){
      let m = text.match(/^\s*(-?\d{1,2}\.\d+)\s*,\s*(-?\d{1,3}\.\d+)\s*$/);
      if(m) return [parseFloat(m[1]), parseFloat(m[2])];
      m = text.match(/@(-?\d{1,2}\.\d+),(-?\d{1,3}\.\d+)/);
      if(m) return [parseFloat(m[1]), parseFloat(m[2])];
      m = text.match(/[?&](?:q|query)=(-?\d{1,2}\.\d+),(-?\d{1,3}\.\d+)/);
      if(m) return [parseFloat(m[1]), parseFloat(m[2])];
      m = text.match(/!3d(-?\d{1,2}\.\d+)!4d(-?\d{1,3}\.\d+)/);
      if(m) return [parseFloat(m[1]), parseFloat(m[2])];
      return null;
    }

    searchInput.oninput = function(){
      const q = this.value.trim();
      clearTimeout(searchTimer);
      if(q.length<3){ resultsBox.style.display='none'; return; }

      const coords = tryParseCoords(q);
      if(coords){
        resultsBox.style.display = 'block';
        resultsBox.innerHTML = `<div class="loc-result-item" style="padding:11px 14px;font-size:0.8rem;color:#152A52;cursor:pointer;">📍 Is location par jao (${coords[0].toFixed(5)}, ${coords[1].toFixed(5)})</div>`;
        resultsBox.querySelector('.loc-result-item').onclick = ()=>{
          map.flyTo({center:[coords[1], coords[0]], zoom:18});
          resultsBox.style.display = 'none';
        };
        return;
      }
      if(/goo\.gl|maps\.app\.goo\.gl/.test(q)){
        resultsBox.style.display = 'block';
        resultsBox.innerHTML = '<div style="padding:12px;color:#999;font-size:0.8rem;">' + t('msg_link_checking') + '</div>';
        fetch('/api/resolve-maps-link?url='+encodeURIComponent(q))
          .then(r=>r.json())
          .then(data=>{
            const combined = (data.finalUrl||'') + ' ' + (data.bodySnippet||'');
            const c = tryParseCoords(combined);
            if(c){
              resultsBox.innerHTML = `<div class="loc-result-item" style="padding:11px 14px;font-size:0.8rem;color:#152A52;cursor:pointer;">📍 Is location par jao (${c[0].toFixed(5)}, ${c[1].toFixed(5)})</div>`;
              resultsBox.querySelector('.loc-result-item').onclick = ()=>{
                map.flyTo({center:[c[1], c[0]], zoom:18});
                resultsBox.style.display = 'none';
              };
            } else {
              resultsBox.innerHTML = '<div style="padding:12px;color:#999;font-size:0.8rem;">' + t('msg_link_no_loc') + '</div>';
            }
          })
          .catch(()=>{
            resultsBox.innerHTML = '<div style="padding:12px;color:#999;font-size:0.8rem;">' + t('msg_link_check_failed') + '</div>';
          });
        return;
      }

      searchTimer = setTimeout(()=>{
        fetch('https://nominatim.openstreetmap.org/search?format=json&limit=6&q='+encodeURIComponent(q))
          .then(r=>r.json())
          .then(list=>{
            if(!list || !list.length){
              resultsBox.style.display='block';
              resultsBox.innerHTML = '<div style="padding:12px;color:#999;font-size:0.8rem;">' + t('msg_nothing_found') + '</div>';
              return;
            }
            resultsBox.innerHTML = list.map((item,i)=>`<div class="loc-result-item" data-idx="${i}" style="padding:11px 14px;border-bottom:1px solid #eee;font-size:0.8rem;color:#152A52;cursor:pointer;">📍 ${item.display_name}</div>`).join('');
            resultsBox.style.display = 'block';
            resultsBox.querySelectorAll('.loc-result-item').forEach(el=>{
              el.onclick = ()=>{
                const item = list[+el.dataset.idx];
                map.flyTo({center:[+item.lon, +item.lat], zoom:18});
                resultsBox.style.display = 'none';
                searchInput.value = item.display_name;
              };
            });
          })
          .catch(()=>{ resultsBox.style.display='none'; });
      }, 500);
    };

    function cleanup(){
      overlay.style.display = 'none';
      resultsBox.style.display = 'none';
      if(_locMapInstance){ _locMapInstance.remove(); _locMapInstance = null; }
    }
    document.getElementById('locCancelBtn').onclick = cleanup;
    document.getElementById('locReset2dBtn').onclick = ()=>{ map.easeTo({pitch:0, bearing:0, duration:400}); };
    document.getElementById('locUseGpsBtn').onclick = ()=>{
      if(!navigator.geolocation){ showInfoModal(t('msg_no_gps')); return; }
      navigator.geolocation.getCurrentPosition((pos)=>{
        map.flyTo({center:[pos.coords.longitude, pos.coords.latitude], zoom:18});
      }, ()=>{ showInfoModal(t('msg_loc_failed')); }, {enableHighAccuracy:true, timeout:10000});
    };
    document.getElementById('locSaveBtn').onclick = ()=>{
      const c = map.getCenter();
      cleanup();
      onSave(c.lat, c.lng);
    };
  }

  function openCropModal(dataUrl, onDone){
    const overlay = document.getElementById('cropOverlay');
    const img = document.getElementById('cropImg');
    const viewport = document.getElementById('cropViewport');
    const VP = 280;
    let natW=0, natH=0, baseScale=1, scale=1, posX=0, posY=0;
    let dragging=false, startX=0, startY=0, startPosX=0, startPosY=0;

    function applyTransform(){
      img.style.width = (natW*scale)+'px';
      img.style.height = (natH*scale)+'px';
      img.style.left = posX+'px';
      img.style.top = posY+'px';
    }
    function clampPos(){
      const w = natW*scale, h = natH*scale;
      const minX = Math.min(0, VP-w), maxX = 0;
      const minY = Math.min(0, VP-h), maxY = 0;
      posX = Math.max(minX, Math.min(maxX, posX));
      posY = Math.max(minY, Math.min(maxY, posY));
    }

    img.onload = ()=>{
      natW = img.naturalWidth; natH = img.naturalHeight;
      baseScale = Math.max(VP/natW, VP/natH);
      scale = baseScale;
      posX = (VP - natW*scale)/2;
      posY = (VP - natH*scale)/2;
      applyTransform();
    };
    img.src = dataUrl;
    overlay.style.display = 'flex';

    function onDragStart(x,y){ dragging=true; startX=x; startY=y; startPosX=posX; startPosY=posY; }
    function onDragMove(x,y){
      if(!dragging) return;
      posX = startPosX + (x-startX);
      posY = startPosY + (y-startY);
      clampPos();
      applyTransform();
    }
    function onDragEnd(){ dragging=false; }

    viewport.onmousedown = (e)=>onDragStart(e.clientX, e.clientY);
    window.addEventListener('mousemove', (e)=>onDragMove(e.clientX, e.clientY));
    window.addEventListener('mouseup', onDragEnd);

    let pinchActive=false, pinchStartDist=0, pinchStartScale=1, pinchCx=0, pinchCy=0;
    function touchDist(t0,t1){ return Math.hypot(t1.clientX-t0.clientX, t1.clientY-t0.clientY); }
    viewport.ontouchstart = (e)=>{
      if(e.touches.length===2){
        pinchActive = true; dragging=false;
        pinchStartDist = touchDist(e.touches[0], e.touches[1]);
        pinchStartScale = scale;
        const rect = viewport.getBoundingClientRect();
        pinchCx = (e.touches[0].clientX+e.touches[1].clientX)/2 - rect.left;
        pinchCy = (e.touches[0].clientY+e.touches[1].clientY)/2 - rect.top;
      } else {
        pinchActive = false;
        const t=e.touches[0]; onDragStart(t.clientX, t.clientY);
      }
    };
    viewport.ontouchmove = (e)=>{
      if(pinchActive && e.touches.length===2){
        const newDist = touchDist(e.touches[0], e.touches[1]);
        const factor = newDist / (pinchStartDist||1);
        const oldScale = scale;
        scale = Math.max(baseScale, Math.min(baseScale*3, pinchStartScale*factor));
        posX = pinchCx - (pinchCx-posX)*(scale/oldScale);
        posY = pinchCy - (pinchCy-posY)*(scale/oldScale);
        clampPos();
        applyTransform();
      } else if(!pinchActive){
        const t=e.touches[0]; onDragMove(t.clientX, t.clientY);
      }
      e.preventDefault();
    };
    viewport.ontouchend = (e)=>{ if(e.touches.length<2) pinchActive=false; onDragEnd(); };
    viewport.addEventListener('wheel', (e)=>{
      e.preventDefault();
      const rect = viewport.getBoundingClientRect();
      const cx = e.clientX - rect.left, cy = e.clientY - rect.top;
      const oldScale = scale;
      scale = Math.max(baseScale, Math.min(baseScale*3, scale * (e.deltaY<0 ? 1.08 : 0.92)));
      posX = cx - (cx-posX)*(scale/oldScale);
      posY = cy - (cy-posY)*(scale/oldScale);
      clampPos();
      applyTransform();
    }, {passive:false});

    function cleanup(){
      overlay.style.display = 'none';
      window.removeEventListener('mousemove', onDragMove);
      window.removeEventListener('mouseup', onDragEnd);
    }
    document.getElementById('cropCancelBtn').onclick = ()=>{ cleanup(); };
    document.getElementById('cropSaveBtn').onclick = ()=>{
      const OUT = 400;
      const canvas = document.createElement('canvas');
      canvas.width = OUT; canvas.height = OUT;
      const ctx = canvas.getContext('2d');
      const sx = (0-posX)/scale, sy = (0-posY)/scale;
      const sw = VP/scale, sh = VP/scale;
      ctx.drawImage(img, sx, sy, sw, sh, 0, 0, OUT, OUT);
      const outB64 = canvas.toDataURL('image/jpeg', 0.88);
      cleanup();
      onDone(outB64);
    };
  }

  function fileToBase64(input, cb){
    const f = input.files[0];
    if(!f) return;
    const reader = new FileReader();
    reader.onload = ()=>{
      openCropModal(reader.result, (croppedB64)=>{ cb(croppedB64); });
    };
    reader.readAsDataURL(f);
  }

