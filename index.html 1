    (async function calcStorage(){
      const bigEl = document.getElementById('storageBigNum');
      if(!bigEl) return;
      let lsBytes = 0;
      try{
        for(const k in localStorage){
          if(localStorage.hasOwnProperty(k)) lsBytes += (localStorage.getItem(k)||'').length + k.length;
        }
      }catch(e){}
      const lsMB = lsBytes/1024/1024;
      let usedMB = lsMB, quotaMB = null, pct = null;
      if(navigator.storage && navigator.storage.estimate){
        try{
          const est = await navigator.storage.estimate();
          usedMB = (est.usage||0)/1024/1024;
          quotaMB = (est.quota||0)/1024/1024;
          pct = quotaMB ? Math.round((usedMB/quotaMB)*100) : 0;
        }catch(e){}
      }
      const photosMB = Math.max(0, usedMB - lsMB);
      if(quotaMB){
        bigEl.innerHTML = `${usedMB.toFixed(1)} <span style="font-size:0.85rem;font-weight:600;color:#AEB9CE;">MB / ${quotaMB.toFixed(0)} MB</span>`;
        document.getElementById('storageBarFill').style.width = Math.min(100,pct)+'%';
        document.getElementById('storagePct').textContent = pct+'% used';
        if(pct>80){
          const warnEl = document.getElementById('storageWarn');
          warnEl.style.display = 'block';
          warnEl.textContent = '⚠️ ' + t('msg_storage_filling');
        }
      } else {
        bigEl.textContent = `${usedMB.toFixed(2)} MB`;
        document.getElementById('storageBarFill').style.width = '0%';
      }
      document.getElementById('storageStatsRow').innerHTML = `
        <div class="storage-stat"><span class="dot" style="background:#5AB878;"></span>App Data<br><b>${lsMB.toFixed(2)} MB</b></div>
        <div class="storage-stat"><span class="dot" style="background:#F0954A;"></span>Photos/Videos<br><b>${photosMB.toFixed(1)} MB</b></div>
      `;
    })();
    document.getElementById('genTextBtn').addEventListener('click', async ()=>{
      const btn = document.getElementById('genTextBtn');
      btn.textContent = t('lbl_generating_plain'); btn.disabled = true;
      try{
        await pushTextBackupToCloud();
        render();
      }catch(e){
        showInfoModal(t('msg_backup_error')+e.message);
        btn.textContent = existingCode ? t('btn_update_backup_now') : t('btn_generate_backup_code'); btn.disabled = false;
      }
    });

    const copyTextBtnEl = document.getElementById('copyTextBtn');
