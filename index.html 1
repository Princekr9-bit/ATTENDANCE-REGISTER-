  function currentItemLocationId(itemId){
    const moves = itemMoves.filter(m=>m.itemId===itemId).sort((a,b)=>(a.date+a.id).localeCompare(b.date+b.id));
    return moves.length ? moves[moves.length-1].toSiteId : null;
  }
  function locName(siteIdOrNull){
    if(!siteIdOrNull) return '🏢 Company Warehouse';
    const s = sites.find(x=>x.id===siteIdOrNull);
    return s ? '📍 '+s.name : '—';
  }

