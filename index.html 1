  async function exportExcelReportWithChart(){
    const months = Array.from(new Set(transactions.map(t=>monthKey(t.date)))).sort();
    const rows = months.map(mk=>{
      const list = transactions.filter(t=>monthKey(t.date)===mk);
      const inc = list.filter(t=>t.type==='income').reduce((a,b)=>a+b.amount,0);
      const exp = list.filter(t=>t.type==='expense').reduce((a,b)=>a+b.amount,0);
      const d = new Date(mk+'-01');
      const lbl = isNaN(d) ? mk : d.toLocaleDateString(localeTag(),{month:'short', year:'numeric'});
      return { mk, lbl, inc, exp, net: inc-exp };
    });

    // ---- Draw the profit/loss chart onto a canvas so it can be embedded as a picture ----
    const W = 900, H = 420, PAD = 60;
    const canvas = document.createElement('canvas');
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#ffffff'; ctx.fillRect(0,0,W,H);
    ctx.fillStyle = '#152A52'; ctx.font = 'bold 20px Arial'; ctx.fillText((company.name||'Company')+' — Profit & Loss Trend', PAD, 32);

    if(rows.length){
      const maxVal = Math.max(1, ...rows.map(r=>Math.max(r.inc, r.exp)));
      const chartW = W - PAD*2, chartH = H - PAD - 50;
      const baseY = H - 50;
      const stepX = chartW / rows.length;
      const barW = Math.min(28, stepX*0.32);
      // axes
      ctx.strokeStyle = '#D8DEE8'; ctx.lineWidth = 1;
      for(let g=0; g<=4; g++){
        const gy = baseY - (chartH*g/4);
        ctx.beginPath(); ctx.moveTo(PAD, gy); ctx.lineTo(W-PAD/2, gy); ctx.stroke();
        ctx.fillStyle = '#8A93A3'; ctx.font = '11px Arial';
        ctx.fillText(rupee(Math.round(maxVal*g/4)), 6, gy+4);
      }
      // bars: income (green) & expense (red)
      rows.forEach((r,i)=>{
        const cx = PAD + stepX*i + stepX/2;
        const incH = (r.inc/maxVal)*chartH;
        const expH = (r.exp/maxVal)*chartH;
        ctx.fillStyle = '#2E8B57';
        ctx.fillRect(cx-barW-2, baseY-incH, barW, incH);
        ctx.fillStyle = '#C1442D';
        ctx.fillRect(cx+2, baseY-expH, barW, expH);
        ctx.fillStyle = '#4A5568'; ctx.font = '11px Arial'; ctx.textAlign = 'center';
        ctx.fillText(r.lbl, cx, baseY+16);
      });
      ctx.textAlign = 'left';
      // net profit line
      ctx.strokeStyle = '#152A52'; ctx.lineWidth = 2.5; ctx.beginPath();
      rows.forEach((r,i)=>{
        const cx = PAD + stepX*i + stepX/2;
        const ny = baseY - (Math.max(0,r.net)/maxVal)*chartH;
        if(i===0) ctx.moveTo(cx, ny); else ctx.lineTo(cx, ny);
      });
      ctx.stroke();
      rows.forEach((r,i)=>{
        const cx = PAD + stepX*i + stepX/2;
        const ny = baseY - (Math.max(0,r.net)/maxVal)*chartH;
        ctx.fillStyle = '#152A52';
        ctx.beginPath(); ctx.arc(cx, ny, 3.5, 0, Math.PI*2); ctx.fill();
      });
      // legend
      const legendY = 18;
      ctx.fillStyle = '#2E8B57'; ctx.fillRect(W-260, legendY-10, 12, 12);
      ctx.fillStyle = '#333'; ctx.font = '12px Arial'; ctx.fillText(t('lbl_income_short'), W-242, legendY);
      ctx.fillStyle = '#C1442D'; ctx.fillRect(W-170, legendY-10, 12, 12);
      ctx.fillStyle = '#333'; ctx.fillText(t('lbl_expense_short'), W-152, legendY);
      ctx.fillStyle = '#152A52'; ctx.fillRect(W-80, legendY-10, 12, 12);
      ctx.fillStyle = '#333'; ctx.fillText(t('lbl_net_profit_short'), W-62, legendY);
    } else {
      ctx.fillStyle = '#8A93A3'; ctx.font = '14px Arial'; ctx.fillText(t('lbl_no_data_available'), PAD, H/2);
    }
    const chartBase64 = canvas.toDataURL('image/png').split(',')[1];

    // ---- Build the Excel workbook ----
    const wb = new ExcelJS.Workbook();
    wb.creator = company.name || t('lbl_app_name_fallback');
    const ws = wb.addWorksheet(t('profit_loss_title'));
    ws.columns = [
      { header: t('excel_month_header'), key: 'lbl', width: 18 },
      { header: t('excel_income_header'), key: 'inc', width: 16 },
      { header: t('excel_expense_header'), key: 'exp', width: 16 },
      { header: t('excel_net_header'), key: 'net', width: 20 }
    ];
    ws.getRow(1).font = { bold: true, color: { argb: 'FFFFFFFF' } };
    ws.getRow(1).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF152A52' } };
    rows.forEach(r=>{ ws.addRow({ lbl: r.lbl, inc: r.inc, exp: r.exp, net: r.net }); });
    const totalIncome = rows.reduce((a,b)=>a+b.inc,0);
    const totalExpense = rows.reduce((a,b)=>a+b.exp,0);
    const totalRow = ws.addRow({ lbl: 'TOTAL', inc: totalIncome, exp: totalExpense, net: totalIncome-totalExpense });
    totalRow.font = { bold: true };
    ws.getColumn('inc').numFmt = '₹#,##0';
    ws.getColumn('exp').numFmt = '₹#,##0';
    ws.getColumn('net').numFmt = '₹#,##0';

    const imgId = wb.addImage({ base64: chartBase64, extension: 'png' });
    ws.addImage(imgId, { tl: { col: 5, row: 1 }, ext: { width: W, height: H } });

    const buf = await wb.xlsx.writeBuffer();
    const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = (company.name||'Report').replace(/\s+/g,'_')+'_Profit_Loss_Report.xlsx';
    a.click();
    URL.revokeObjectURL(url);
  }

