      const myAtt = attendance.filter(a=>a.workerId===id).sort((a,b)=>b.date.localeCompare(a.date));
      const myAdv = advances.filter(a=>a.workerType===kind && a.workerId===id).sort((a,b)=>b.date.localeCompare(a.date));
