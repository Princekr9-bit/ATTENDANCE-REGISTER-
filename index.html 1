    document.querySelectorAll('[data-paytick]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const key = el.dataset.paytick;
        state._attTickOpen = (state._attTickOpen === key) ? null : key;
        render();
      });
    });
    document.querySelectorAll('[data-attlocktap]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const key = el.dataset.attlocktap;
        state._attEditOpen = (state._attEditOpen === key) ? null : key;
        render();
      });
    });
    document.querySelectorAll('[data-editall]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [kind,wid] = el.dataset.editall.split('|');
        unlockAttendance(wid, kind, date);
        clearPayResolved(wid, kind, date);
        state._attEditOpen = null;
        render();
      });
