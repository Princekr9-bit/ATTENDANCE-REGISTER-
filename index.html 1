        return `<div class="list-row" data-selectpay="sup|${pm.id}" style="cursor:pointer;"><div><div class="l1">${dispDate(pm.date)}</div><div class="l2">${pm.note||''}</div></div><div style="text-align:right;"><div class="amt-out">${rupee(pm.amount)}</div>${isSel?`<div style="margin-top:4px;">${iconActionsHtml('data-editpay','sup|'+pm.id,'data-delpay','sup|'+pm.id)}</div>`:''}</div></div>`;
