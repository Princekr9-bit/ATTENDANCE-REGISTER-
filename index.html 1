                const drv = r.withDriverId ? driver.find(d=>d.id===r.withDriverId) : null;
                return '🚚 Driver ke saath: '+(drv?drv.name:(r.withDriverName||'—'))+(r.status==='H' ? ' (½ day)' : '')+timeTag;
