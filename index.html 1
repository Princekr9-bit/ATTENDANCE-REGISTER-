    const spInput = document.getElementById('sitePhotoInput');
    let pendingMedia = null, pendingType = 'image';
    if(spInput) spInput.addEventListener('change', function(){
      mediaToBase64(this, (b64,type)=>{ pendingMedia=b64; pendingType=type; });
    });
    const mapModeEls = document.querySelectorAll('[data-mapmode]');
    mapModeEls.forEach(el=>{
      el.addEventListener('click', ()=>{ state._siteMapMode = el.dataset.mapmode; render(); });
    });
    const map2dRotateEl = document.getElementById('map2dRotate');
    const map2dImgEl = document.getElementById('map2dImg');
    const map2dViewportEl = document.getElementById('map2dViewport');
    let map2dAngle = 0, map2dScale = 1;
    function applyMap2dTransform(){
      if(!map2dImgEl) return;
      map2dImgEl.style.transform = `rotate(${map2dAngle}deg) scale(${map2dScale})`;
      if(map2dRotateEl) map2dRotateEl.value = Math.round(((map2dAngle%360)+360)%360);
    }
    if(map2dRotateEl) map2dRotateEl.addEventListener('input', function(){
      map2dAngle = parseFloat(this.value);
      applyMap2dTransform();
    });
    if(map2dViewportEl && map2dImgEl){
      let dragging2d=false, lastAngleTouch=0, centerX=0, centerY=0;
      let pinching2d=false, pinchStartDist2d=0, pinchStartScale2d=1;
      function angleAt(x,y){ return Math.atan2(y-centerY, x-centerX) * (180/Math.PI); }
      function touchDist2d(t0,t1){ return Math.hypot(t1.clientX-t0.clientX, t1.clientY-t0.clientY); }
      map2dViewportEl.addEventListener('touchstart', (e)=>{
        const rect = map2dViewportEl.getBoundingClientRect();
        centerX = rect.left + rect.width/2; centerY = rect.top + rect.height/2;
        if(e.touches.length===2){
          pinching2d = true; dragging2d = false;
          pinchStartDist2d = touchDist2d(e.touches[0], e.touches[1]);
          pinchStartScale2d = map2dScale;
        } else {
          pinching2d = false; dragging2d = true;
          lastAngleTouch = angleAt(e.touches[0].clientX, e.touches[0].clientY);
        }
      });
      map2dViewportEl.addEventListener('touchmove', (e)=>{
        if(pinching2d && e.touches.length===2){
          const newDist = touchDist2d(e.touches[0], e.touches[1]);
          map2dScale = Math.max(0.4, Math.min(3, pinchStartScale2d * (newDist/(pinchStartDist2d||1))));
          applyMap2dTransform();
        } else if(dragging2d && e.touches.length===1){
          const ang = angleAt(e.touches[0].clientX, e.touches[0].clientY);
          map2dAngle += (ang - lastAngleTouch);
          lastAngleTouch = ang;
          applyMap2dTransform();
        }
        e.preventDefault();
      });
      map2dViewportEl.addEventListener('touchend', (e)=>{ if(e.touches.length<2) pinching2d=false; if(e.touches.length<1) dragging2d=false; });
      // mouse drag support (desktop)
      let mouseDragging2d=false;
      map2dViewportEl.addEventListener('mousedown', (e)=>{
        const rect = map2dViewportEl.getBoundingClientRect();
        centerX = rect.left + rect.width/2; centerY = rect.top + rect.height/2;
        mouseDragging2d = true; lastAngleTouch = angleAt(e.clientX, e.clientY);
      });
      window.addEventListener('mousemove', (e)=>{
        if(!mouseDragging2d) return;
        const ang = angleAt(e.clientX, e.clientY);
        map2dAngle += (ang - lastAngleTouch);
        lastAngleTouch = ang;
        applyMap2dTransform();
      });
      window.addEventListener('mouseup', ()=>{ mouseDragging2d=false; });
    }
    const r3dAddBtn = document.getElementById('r3dAddBtn');
    if(r3dAddBtn) r3dAddBtn.addEventListener('click', ()=>{
      const name = document.getElementById('r3dName').value.trim() || 'Room';
      const room = {
        name,
        x: parseFloat(document.getElementById('r3dX').value)||0,
        y: parseFloat(document.getElementById('r3dY').value)||0,
        w: parseFloat(document.getElementById('r3dW').value)||4,
        d: parseFloat(document.getElementById('r3dD').value)||4,
        h: parseFloat(document.getElementById('r3dH').value)||3
      };
      const updated = {...s, rooms3D: [...(s.rooms3D||[]), room]};
      sites = sites.map(x=>x.id===s.id?updated:x);
      save(K.sites, sites);
      render();
    });
    document.querySelectorAll('[data-delroom3d]').forEach(el=>{
