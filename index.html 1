      html += `<div class="site-summary-head">
        <div><div class="ssh-title">${t('site_wise_summary')}</div><div class="ssh-sub">${t('tap_site_details')}</div></div>
        ${sitesWithActivity.length>4 ? (showAllSites
          ? `<button type="button" class="ssh-viewall-btn" id="siteShowLessBtn">${t('show_less')}</button>`
          : `<button type="button" class="ssh-viewall-btn" id="siteViewAllBtn">${t('view_all_sites')}</button>`) : ''}
      </div>`;
      html += `<div class="site-summary-grid">`;
      html += visibleSites.map(({s,si,se,lastDate})=>{
        const net = si-se;
        const initials = (s.name||'?').slice(0,2).toUpperCase();
        return `<div class="site-summary-card" data-nav="profitloss:${s.id}">
          <div class="ssc-top">
            <div class="ssc-avatar">${s.ownerPhoto?`<img src="${s.ownerPhoto}">`:initials}</div>
            <div class="ssc-name">${s.name}</div>
            <div class="chev">›</div>
          </div>
          <div class="ssc-row">
            <div class="ssc-col"><div class="ssc-lbl">Income</div><div class="ssc-val" style="color:var(--green);">${rupee(si)}</div></div>
            <div class="ssc-col"><div class="ssc-lbl">Expense</div><div class="ssc-val" style="color:var(--red);">${rupee(se)}</div></div>
          </div>
          <div class="ssc-row">
            <div class="ssc-col"><div class="ssc-lbl">Profit</div><div class="ssc-val" style="color:${net>=0?'var(--green)':'var(--red)'};">${rupee(net)}</div></div>
            <div class="ssc-col"><div class="ssc-lbl">Last Activity</div><div class="ssc-val" style="font-size:0.72rem;font-weight:700;">${lastDate?dispDate(lastDate):'—'}</div></div>
          </div>
        </div>`;
      }).join('');
      html += `</div>`;

      if(laborTotal>0){
        const payDate = state._payDateFilter || '';
        const wpMatch = t => payDate ? t.date===payDate : monthKey(t.date)===month;
        const workerWageTotal = wagePayments.filter(wpMatch).reduce((a,b)=>a+b.amount,0);
        const workerAdvTotal = advances.filter(a=>wpMatch(a) && a.workerType!=='supervisor').reduce((a,b)=>a+b.amount,0);
        const workerTotal = workerWageTotal + workerAdvTotal;
        const supAdvTotal = advances.filter(a=>wpMatch(a) && a.workerType==='supervisor').reduce((a,b)=>a+b.amount,0);
        const supPayTotal = supPayments.filter(wpMatch).reduce((a,b)=>a+b.amount,0);
        const supTotalFiltered = supAdvTotal + supPayTotal;
        html += `<div class="form-box" style="margin:14px 0 10px;">
          <label style="margin-top:0;">📅 Check a specific date (optional)</label>
          <input type="date" id="payDateFilter" value="${payDate}">
          ${payDate ? `<button class="link-btn" id="payDateClear">✕ Clear date, show whole month</button>` : `<div class="meta" style="color:var(--ink-soft);">Leave blank to see the whole month's total</div>`}
        </div>`;
        html += glowIconCardHtml({icon:'👷', color:'#2A5CA8', shadow:'rgba(42,92,168,0.35)', title:t('workers_payment'), meta:`${t('lbl_labourers_masons_drivers')} · ${payDate?dispDate(payDate):t('lbl_this_month_word')}`, amount:rupee(workerTotal), navTarget:`workerPaymentCalendar:${month}`});
        html += glowIconCardHtml({icon:'👔', color:'#6C4FA1', shadow:'rgba(108,79,161,0.35)', title:t('lbl_supervisor_payment_title'), meta:`${payDate?dispDate(payDate):t('this_month_label')}`, amount:rupee(supTotalFiltered), navTarget:'salary'});
      }
      const petrolThisMonth = list.filter(t=>t.type==='expense' && t.category==='petrol');
      const petrolMonthTotal = petrolThisMonth.reduce((a,b)=>a+b.amount,0);
      if(petrolMonthTotal>0){
        const petrolSupCount = new Set(petrolThisMonth.map(t=>t.supId)).size;
        html += glowIconCardHtml({icon:'⛽', color:'#D9B33E', shadow:'rgba(214,159,46,0.4)', title:t('supervisor_petrol'), meta:`${petrolSupCount} supervisor${petrolSupCount>1?'s':''} · ${t('lbl_this_month_word')}`, amount:rupee(petrolMonthTotal), navTarget:`petrolCalendar:${month}`});
      }
      const vehicleWide = list.filter(t=>!t.siteId && t.vehicleId);
      if(vehicleWide.length){
        const vwNet = vehicleWide.reduce((a,b)=>a+(b.type==='income'?b.amount:-b.amount),0);
        html += glowIconCardHtml({icon:'🚚', color:'#5AAE73', shadow:'rgba(90,174,115,0.35)', title:t('lbl_vehicles_equipment_title'), meta:t('lbl_veh_equip_meta'), amount:rupee(vwNet), amountClass:vwNet>=0?'amt-in':'amt-out', navTarget:'vehicles'});
      }
      const itemWide = list.filter(t=>!t.siteId && t.itemId);
      if(itemWide.length){
        const iwNet = itemWide.reduce((a,b)=>a+(b.type==='income'?b.amount:-b.amount),0);
        html += glowIconCardHtml({icon:'📦', color:'#8E7CC3', shadow:'rgba(142,124,195,0.35)', title:t('lbl_saman_inventory_title2'), meta:t('lbl_saman_meta'), amount:rupee(iwNet), amountClass:iwNet>=0?'amt-in':'amt-out', navTarget:'inventory'});
      }
      const miscWide = list.filter(t=>t.category==='misc');
      if(miscWide.length){
        const mwTotal = miscWide.reduce((a,b)=>a+b.amount,0);
        html += glowIconCardHtml({icon:'💸', color:'#C1442D', shadow:'rgba(193,68,45,0.35)', title:t('other_expenses_title'), meta:t('lbl_misc_company_expenses'), amount:rupee(mwTotal), navTarget:'otherExpenses'});
      }
      if(rentThisMonthTotal>0){
        html += glowIconCardHtml({icon:'🏠', color:'#2A5CA8', shadow:'rgba(42,92,168,0.35)', title:t('rent_title'), meta:t('lbl_rent_meta'), amount:rupee(rentThisMonthTotal), navTarget:'rentList'});
      }
      if(udharGivenThisMonth.length || udharGivenRepayIncome>0){
        const givenNet = udharGivenRepayIncome - udharGivenTotal;
        html += glowIconCardHtml({icon:'🤝', color:'#D9B33E', shadow:'rgba(214,159,46,0.35)', title:t('lbl_udhar_diya_title'), meta:`${t('lbl_given_short')}: ${rupee(udharGivenTotal)} · ${t('lbl_came_back')}: ${rupee(udharGivenRepayIncome)}`, amount:rupee(givenNet), amountClass:givenNet>=0?'amt-in':'amt-out', navTarget:'udhar'});
      }
      if(udharTakenThisMonth.length || udharTakenRepayExpense>0){
        const takenNet = udharTakenTotal - udharTakenRepayExpense;
        html += glowIconCardHtml({icon:'🤝', color:'#B5541F', shadow:'rgba(181,84,31,0.35)', title:t('lbl_udhar_liya_title'), meta:`${t('lbl_taken_short')}: ${rupee(udharTakenTotal)} · ${t('lbl_paid_back')}: ${rupee(udharTakenRepayExpense)}`, amount:rupee(takenNet), amountClass:takenNet>=0?'amt-in':'amt-out', navTarget:'udhar'});
      }

      const entryRowHtml = (tx)=>{
        const s = sites.find(x=>x.id===tx.siteId);
        const v = tx.vehicleId ? vehicles.find(x=>x.id===tx.vehicleId) : null;
        const itm = tx.itemId ? inventory.find(x=>x.id===tx.itemId) : null;
        let where = s ? s.name : (v ? '🚚 '+v.name : (itm ? '📦 '+itm.name : (tx.category==='misc' ? '💸 '+t('lbl_other_expense_single') : (tx.category==='rent' ? '🏠 '+t('rent_title') : (tx.category==='purchase' ? '📦 '+t('lbl_company_purchase') : (tx.category==='petrol' ? '⛽ '+t('lbl_petrol_word2') : t('lbl_company_expense')))))));
        if(state._plEditTx===tx.id){
          return `<div class="form-box" style="margin-bottom:10px;">
            <label>${t('lbl_reason')}</label><input type="text" id="plEditReason" value="${escapeHtml(tx.reason||'')}">
            <label>${t('date_label')}</label><input type="date" id="plEditDate" value="${tx.date}">
            <label>${t('amount')} (₹)</label><input type="number" id="plEditAmt" value="${tx.amount}">
            <div class="row2" style="margin-top:8px;">
              <button class="save-btn" id="plEditSave" style="margin:0;">${t('save')}</button>
              <button class="link-btn" id="plEditCancel" style="margin:0;">${t('cancel_word')}</button>
            </div>
          </div>`;
        }
        const isSel = state._plSelectedTx===tx.id;
        return `<div class="entry-row ${tx.type==='income'?'inc':'exp'}" data-selectpltx="${tx.id}">
          <div class="er-ico" style="background:${tx.type==='income'?'rgba(46,139,87,0.12)':'rgba(193,68,45,0.12)'};color:${tx.type==='income'?'var(--green)':'var(--red)'};">${tx.type==='income'?'↑':'↓'}</div>
          <div style="flex:1;min-width:0;"><div class="l1">${tx.reason||(tx.type==='income'?t('lbl_income_word'):t('lbl_expense_word'))}</div><div class="l2">${dispDate(tx.date)} · ${where}</div></div>
          <div style="text-align:right;"><div class="${tx.type==='income'?'amt-in':'amt-out'}">${tx.type==='income'?'+':'-'}${rupee(tx.amount)}</div>${isSel?`<div style="margin-top:4px;">${iconActionsHtml('data-editpltx',tx.id,'data-delpltx',tx.id)}</div>`:''}</div>
        </div>`;
      };
      const incomeEntries = list.filter(t=>t.type==='income');
      const nonPetrolExpense = list.filter(t=>t.type==='expense' && t.category!=='petrol');
      const incomeTotal = incomeEntries.reduce((a,b)=>a+b.amount,0);
      const expenseTotal = nonPetrolExpense.reduce((a,b)=>a+b.amount,0);
      html += `<div class="entry-section">`;
      html += sectionHeaderHtml('📈','rgba(46,139,87,0.12)','var(--green)',t('lbl_income_entries_month'), incomeEntries.length, rupee(incomeTotal), 'var(--green)');
      html += incomeEntries.length ? incomeEntries.map(entryRowHtml).join('') : `<div class="meta" style="color:var(--ink-soft);">${t('lbl_no_income_entries')}</div>`;
      html += `</div>`;
      html += `<div class="entry-section">`;
      html += sectionHeaderHtml('📉','rgba(193,68,45,0.12)','var(--red)',t('lbl_expense_entries_month'), nonPetrolExpense.length, rupee(expenseTotal), 'var(--red)');
      html += nonPetrolExpense.length ? nonPetrolExpense.map(entryRowHtml).join('') : `<div class="meta" style="color:var(--ink-soft);">${t('lbl_no_expense_entries')}</div>`;
      html += `</div>`;
      if(udharThisMonth.length || allRepaymentsThisMonth.length){
        const udharCount = udharThisMonth.length + allRepaymentsThisMonth.length;
        const udharNet = allRepaymentsThisMonth.filter(r=>r.udharKind==='given').reduce((a,b)=>a+b.amount,0)
          + udharThisMonth.filter(u=>u.kind==='taken').reduce((a,b)=>a+b.amount,0)
          - udharThisMonth.filter(u=>u.kind==='given').reduce((a,b)=>a+b.amount,0)
          - allRepaymentsThisMonth.filter(r=>r.udharKind==='taken').reduce((a,b)=>a+b.amount,0);
        html += `<div class="entry-section">`;
        html += sectionHeaderHtml('🤝','rgba(214,159,46,0.15)','var(--amber)',t('lbl_udhar_entries_month'), udharCount, rupee(udharNet), udharNet>=0?'var(--green)':'var(--red)');
        html += udharThisMonth.map(u=>{
          const lbl = u.kind==='given' ? t('lbl_given_to')+u.name : t('lbl_taken_from')+u.name;
          const isSel = state._plSelectedUdhar==='main|'+u.id;
          return `<div class="entry-row ${u.kind==='given'?'exp':'inc'}" data-selectplud="main|${u.id}">
            <div class="er-ico" style="background:${u.kind==='given'?'rgba(193,68,45,0.12)':'rgba(46,139,87,0.12)'};color:${u.kind==='given'?'var(--red)':'var(--green)'};">${u.kind==='given'?'↓':'↑'}</div>
            <div style="flex:1;min-width:0;"><div class="l1">${lbl}</div><div class="l2">${dispDate(u.date)}</div></div>
            <div style="text-align:right;"><div class="${u.kind==='given'?'amt-out':'amt-in'}">${u.kind==='given'?'-':'+'}${rupee(u.amount)}</div>${isSel?`<div style="margin-top:4px;">${iconActionsHtml('data-editplud','main|'+u.id,'data-delplud','main|'+u.id)}</div>`:''}</div>
          </div>`;
        }).join('');
        html += allRepaymentsThisMonth.map(r=>{
          const lbl = r.udharKind==='given' ? r.udharName+' ne wapas kiya' : r.udharName+' ko wapas kiya';
          const isSel = state._plSelectedUdhar==='repay|'+r.id;
          return `<div class="entry-row ${r.udharKind==='given'?'inc':'exp'}" data-selectplud="repay|${r.id}">
            <div class="er-ico" style="background:${r.udharKind==='given'?'rgba(46,139,87,0.12)':'rgba(193,68,45,0.12)'};color:${r.udharKind==='given'?'var(--green)':'var(--red)'};">${r.udharKind==='given'?'↑':'↓'}</div>
            <div style="flex:1;min-width:0;"><div class="l1">${lbl}</div><div class="l2">${dispDate(r.date)}${r.note?' · '+r.note:''}</div></div>
            <div style="text-align:right;"><div class="${r.udharKind==='given'?'amt-in':'amt-out'}">${r.udharKind==='given'?'+':'-'}${rupee(r.amount)}</div>${isSel?`<div style="margin-top:4px;">${iconActionsHtml('data-editplud','repay|'+r.id,'data-delplud','repay|'+r.id)}</div>`:''}</div>
          </div>`;
        }).join('');
        html += `</div>`;
      }

    } else {
      const list = transactions.filter(t=>t.siteId===siteId && monthKey(t.date)===month).sort((a,b)=>b.date.localeCompare(a.date));
      const income = list.filter(t=>t.type==='income').reduce((a,b)=>a+b.amount,0);
      const expense = list.filter(t=>t.type==='expense').reduce((a,b)=>a+b.amount,0);
      const sitePrevMonth = shiftMonth(month, -1);
      const sitePrevList = transactions.filter(t=>t.siteId===siteId && monthKey(t.date)===sitePrevMonth);
      const sitePrevIncome = sitePrevList.filter(t=>t.type==='income').reduce((a,b)=>a+b.amount,0);
      const sitePrevExpense = sitePrevList.filter(t=>t.type==='expense').reduce((a,b)=>a+b.amount,0);

      html += `<div class="stat-grid" style="margin-bottom:14px;">
        ${statCardHtml({icon:'₹', bg:'rgba(46,139,87,0.12)', color:'var(--green)', value:rupee(income), label:t('lbl_income_word')})}
        ${statCardHtml({icon:'₹', bg:'rgba(193,68,45,0.12)', color:'var(--red)', value:rupee(expense), label:t('lbl_expense_word')})}
        ${statCardHtml({icon:'📈', bg:'rgba(42,92,168,0.12)', color:'#2A5CA8', value:rupee(income-expense), label:t('lbl_profit_loss_short')})}
      </div>`;

      html += `<div class="form-box">
        <label>${t('lbl_entry_type')}</label>
        <select id="txType" class="plain" style="width:100%;">
          <option value="income">${t('opt_income')}</option>
          <option value="expense">${t('opt_expense')}</option>
        </select>
        <label>Date</label>
        <input type="date" id="txDate" value="${todayStr()}">
        <label>${t('amount')} (₹)</label>
        <input type="number" id="txAmt" placeholder="${t('amount')}">
        <label>${t('lbl_reason')}</label>
        <input type="text" id="txReason" placeholder="e.g. Bought cement / Received from owner">
        <button class="save-btn" id="txSave">${t('add_entry_btn')}</button>
      </div>`;

      const siteIncomeEntries = list.filter(t=>t.type==='income');
      const siteExpenseEntries = list.filter(t=>t.type==='expense');
      const siteEntryRowHtml = (tx)=>{
        if(state._plEditTx===tx.id){
          return `<div class="form-box" style="margin-bottom:10px;">
            <label>${t('lbl_reason')}</label><input type="text" id="plEditReason" value="${escapeHtml(tx.reason||'')}">
            <label>${t('date_label')}</label><input type="date" id="plEditDate" value="${tx.date}">
            <label>${t('amount')} (₹)</label><input type="number" id="plEditAmt" value="${tx.amount}">
            <div class="row2" style="margin-top:8px;">
              <button class="save-btn" id="plEditSave" style="margin:0;">${t('save')}</button>
              <button class="link-btn" id="plEditCancel" style="margin:0;">${t('cancel_word')}</button>
            </div>
          </div>`;
        }
        const isSel = state._plSelectedTx===tx.id;
        return `<div class="list-row" data-selectpltx="${tx.id}" style="cursor:pointer;"><div><div class="l1">${tx.reason||(tx.type==='income'?t('lbl_income_word'):t('lbl_expense_word'))}</div><div class="l2">${dispDate(tx.date)}</div></div><div style="text-align:right;"><div class="${tx.type==='income'?'amt-in':'amt-out'}">${tx.type==='income'?'+':'-'}${rupee(tx.amount)}</div>${isSel?`<div style="margin-top:4px;">${iconActionsHtml('data-editpltx',tx.id,'data-delpltx',tx.id)}</div>`:''}</div></div>`;
      };
      html += `<div class="section-title">📈 ${t('lbl_income_entries_month')}</div>`;
      html += siteIncomeEntries.length ? siteIncomeEntries.map(siteEntryRowHtml).join('') : `<div class="meta" style="color:var(--ink-soft);">${t('lbl_no_income_entries')}</div>`;
      html += `<div class="section-title">📉 ${t('lbl_expense_entries_month')}</div>`;
      html += siteExpenseEntries.length ? siteExpenseEntries.map(siteEntryRowHtml).join('') : `<div class="meta" style="color:var(--ink-soft);">${t('lbl_no_expense_entries')}</div>`;
    }

    app.innerHTML = html;
    document.getElementById('plSite').addEventListener('change', function(){ state._plSite=this.value; state.param=null; render(); });
    document.getElementById('plMonth').addEventListener('change', function(){ state._plMonth=this.value; render(); });
    const viewGraphBtn = document.getElementById('viewFullGraphCard');
    if(viewGraphBtn) viewGraphBtn.addEventListener('click', ()=>{ state._plView='year'; render(); });
    const payDateEl = document.getElementById('payDateFilter');
    if(payDateEl) payDateEl.addEventListener('change', function(){ state._payDateFilter=this.value||null; render(); });
    const payDateClearEl = document.getElementById('payDateClear');
    if(payDateClearEl) payDateClearEl.addEventListener('click', ()=>{ state._payDateFilter=null; render(); });
    const siteViewAllBtn = document.getElementById('siteViewAllBtn');
    if(siteViewAllBtn) siteViewAllBtn.addEventListener('click', ()=>{ state._plShowAllSites=true; render(); });
    const siteShowLessBtn = document.getElementById('siteShowLessBtn');
    if(siteShowLessBtn) siteShowLessBtn.addEventListener('click', ()=>{ state._plShowAllSites=false; render(); });
    const txSaveBtn = document.getElementById('txSave');
    if(txSaveBtn) txSaveBtn.addEventListener('click', ()=>{
      const amount = parseFloat(document.getElementById('txAmt').value)||0;
      if(amount<=0){ showInfoModal(t('msg_valid_amount')); return; }
      transactions.push({id:uid(), siteId, date:document.getElementById('txDate').value, type:document.getElementById('txType').value, amount, reason:document.getElementById('txReason').value.trim()});
      save(K.transactions, transactions);
      render();
    });
    document.querySelectorAll('[data-selectpltx]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const id = el.dataset.selectpltx;
        state._plSelectedTx = (state._plSelectedTx===id) ? null : id;
        render();
      });
    });
    document.querySelectorAll('[data-editpltx]').forEach(el=>{
      el.addEventListener('click', (e)=>{ e.stopPropagation(); state._plEditTx = el.dataset.editpltx; render(); });
    });
    document.querySelectorAll('[data-delpltx]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const id = el.dataset.delpltx;
        showConfirmModal(t('confirm_delete_pl_entry'), ()=>{
          transactions = transactions.filter(t=>t.id!==id);
          save(K.transactions, transactions);
          state._plSelectedTx = null;
          render();
        });
      });
    });
    const plEditSaveBtn = document.getElementById('plEditSave');
    if(plEditSaveBtn) plEditSaveBtn.addEventListener('click', ()=>{
      const amt = parseFloat(document.getElementById('plEditAmt').value)||0;
      if(amt<=0){ showInfoModal(t('msg_valid_amount')); return; }
      const dt = document.getElementById('plEditDate').value;
      const reason = document.getElementById('plEditReason').value.trim();
      transactions = transactions.map(t=>t.id===state._plEditTx ? {...t, amount:amt, date:dt, reason} : t);
      save(K.transactions, transactions);
      state._plEditTx = null;
      render();
    });
    const plEditCancelBtn = document.getElementById('plEditCancel');
    if(plEditCancelBtn) plEditCancelBtn.addEventListener('click', ()=>{ state._plEditTx = null; render(); });

    document.querySelectorAll('[data-selectplud]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const key = el.dataset.selectplud;
        state._plSelectedUdhar = (state._plSelectedUdhar===key) ? null : key;
        render();
      });
    });
    document.querySelectorAll('[data-editplud]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const [t,id] = el.dataset.editplud.split('|');
        if(t==='main'){ goTo('addUdhar', id); }
        else {
          const parent = udhar.find(u=>(u.repayments||[]).some(r=>r.id===id));
          if(parent) goTo('addUdhar', parent.id);
        }
      });
    });
    document.querySelectorAll('[data-delplud]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const [kind2,id] = el.dataset.delplud.split('|');
        showConfirmModal(t('confirm_delete_pl_udhar_entry'), ()=>{
          if(kind2==='main'){
            udhar = udhar.filter(u=>u.id!==id);
          } else {
            udhar = udhar.map(u=>({...u, repayments:(u.repayments||[]).filter(r=>r.id!==id)}));
          }
          save(K.udhar, udhar);
          state._plSelectedUdhar = null;
          render();
        });
      });
    });
  }

  // ===================== REPORT CARD =====================
  // ===================== SUPERVISOR PETROL CALENDAR =====================
  function renderPetrolCalendar(monthParam){
    setTopbar(t('supervisor_petrol'), true);
    if(monthParam && /^\d{4}-\d{2}$/.test(monthParam)) state._petrolCalMonth = monthParam;
    const cmonth = state._petrolCalMonth || todayStr().slice(0,7);
    state._petrolCalMonth = cmonth;
    const selDate = state._petrolCalSelDate || '';

    const petrolTx = transactions.filter(t=>t.type==='expense' && t.category==='petrol');
    const hasPetrol = (dateStr)=>petrolTx.some(t=>t.date===dateStr);
    const monthTx = petrolTx.filter(t=>monthKey(t.date)===cmonth);
    const monthTotal = monthTx.reduce((a,b)=>a+b.amount,0);

    let html = `<div class="petrol-cal-card">
      <div class="petrol-cal-head">
        <div class="petrol-cal-icon">⛽</div>
        <div>
          <div class="petrol-cal-total">${rupee(monthTotal)}</div>
          <div class="petrol-cal-sub">Total petrol given this month</div>
        </div>
      </div>
      <div class="cal-nav" style="margin-top:16px;">
        <button id="petrolPrevBtn">‹</button>
        <input type="month" id="petrolMonthPicker" value="${cmonth}">
        <button id="petrolNextBtn">›</button>
