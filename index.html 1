      <div class="sub">${t('auth_new_pw_sub')}</div>
      ${pwFieldHtml('rpw1', t('ph_new_password'))}
      ${pwFieldHtml('rpw2', t('ph_confirm_password'))}
      <div class="err" id="lockErr"></div>
      <button class="lbtn" id="saveResetBtn">${t('btn_save_new_password')}</button>
    </div>`;
    bindPwToggles();
    document.getElementById('saveResetBtn').addEventListener('click', async ()=>{
      const p1=document.getElementById('rpw1').value, p2=document.getElementById('rpw2').value;
      const err=document.getElementById('lockErr');
      if(!p1 || p1.length<4){ err.textContent=t('err_pw_min_length'); return; }
      if(p1!==p2){ err.textContent=t('err_pw_mismatch'); return; }
      const auth = load(K.auth, {});
      auth.passHash = await hashText(p1);
      save(K.auth, auth);
      unlockApp();
    });
  }

  function unlockApp(){
    sessionStorage.setItem('nm_unlocked','1');
    lockEl.style.display='none';
    startApp();
  }

  function hideSplash(){
    const nameEl = document.getElementById('splashName');
    const logoImg = document.getElementById('splashLogo');
    const logoFallback = document.getElementById('splashLogoFallback');
    if(nameEl) nameEl.textContent = (company && company.name) ? company.name : t('lbl_app_name_fallback');
    if(company && company.logo && logoImg){
      logoImg.src = company.logo;
      logoImg.style.display = 'block';
      if(logoFallback) logoFallback.style.display = 'none';
    } else if(logoFallback){
      logoFallback.textContent = (company && company.name ? company.name[0] : 'N').toUpperCase();
    }
    setTimeout(()=>{
      const splash = document.getElementById('splashScreen');
      if(splash) splash.classList.add('hide');
    }, 500);
  }
  function checkAuthOnLoad(){
    const auth = load(K.auth, null);
    if(!auth){ showCreatePasswordScreen(); hideSplash(); return; }
    if(sessionStorage.getItem('nm_unlocked')==='1'){ lockEl.style.display='none'; startApp(); hideSplash(); return; }
    showEnterPasswordScreen();
    hideSplash();
  }

