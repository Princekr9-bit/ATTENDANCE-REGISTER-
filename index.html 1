    if(!('Notification' in window)) return;
    if(Notification.permission!=='granted') return;
    const nowVal = nowLocalKey();
    let changed = false;
    notes.forEach(n=>{
      if(!n.reminderDate) return;
      const remKey = n.reminderDate+'T'+(n.reminderTime||'00:00');
      if(remKey<=nowVal && n.lastNotifiedKey!==remKey){
        sendNotification(t('notif_reminder_title'), n.text.slice(0,120), 'note-'+n.id);
        n.lastNotifiedKey = remKey;
        changed = true;
      }
    });
    if(changed) save(K.notes, notes);
