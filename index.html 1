    document.getElementById('calPrevBtn').addEventListener('click', ()=>{
      const [y,m] = cmonth.split('-').map(Number);
      const d = new Date(y, m-2, 1);
      state._calMonth = d.getFullYear()+'-'+pad2(d.getMonth()+1);
      render();
    });
    document.getElementById('calNextBtn').addEventListener('click', ()=>{
      const [y,m] = cmonth.split('-').map(Number);
      const d = new Date(y, m, 1);
      state._calMonth = d.getFullYear()+'-'+pad2(d.getMonth()+1);
      render();
    });
    document.querySelectorAll('.cal-day[data-date]').forEach(el=>{
      el.addEventListener('click', function(){
        const dateStr = this.dataset.date;
        const niceDate = dispDate(dateStr);
        if(kind==='supervisor'){
          const r = supAttendance.find(a=>a.supId===id && a.date===dateStr);
          const petrolRec = transactions.find(t=>t.category==='petrol' && t.supId===id && t.date===dateStr);
          if(!r && !petrolRec) return;
          const rows = [];
          if(r) rows.push(['Status', r.status==='P'?'✅ Full day':'❌ Absent']);
          const payRec = supPayments.find(p=>p.supId===id && p.date===dateStr);
          if(payRec) rows.push([t('lbl_payment_received'), rupee(payRec.amount)]);
          const advRec = advances.find(a=>a.workerType==='supervisor' && a.workerId===id && a.date===dateStr);
          if(advRec) rows.push([t('lbl_advance_received'), rupee(advRec.amount)]);
          if(petrolRec) rows.push([t('msg_petrol_given'), rupee(petrolRec.amount)]);
          showDayModal(niceDate, rows);
        } else if(kind==='driver'){
          const r = attendance.find(a=>a.workerId===id && a.date===dateStr);
          const stLbl = r ? (r.status==='P'?'✅ '+t('full_day'):r.status==='H'?'🟡 '+t('half_day'):'❌ '+t('absent')) : t('lbl_not_marked');
          const tasks = itemMoves.filter(m=>m.driverId===id && m.date===dateStr);
          const dn = driverNotes.find(n=>n.driverId===id && n.date===dateStr);
          const rows = [['Status', stLbl]];
          if(dn) rows.push([t('lbl_work_note'), dn.note]);
          if(tasks.length===0){ if(!dn) rows.push([t('lbl_item_movement'), t('lbl_no_item_movement')]); }
          else {
            tasks.forEach(m=>{
              const it = inventory.find(x=>x.id===m.itemId);
              const from = m.fromSiteId ? (sites.find(s=>s.id===m.fromSiteId)||{}).name : t('company_warehouse');
              const to = m.toSiteId ? (sites.find(s=>s.id===m.toSiteId)||{}).name : t('company_warehouse');
              rows.push([it?it.name:t('lbl_item_word'), (from||'—')+' → '+(to||'—')]);
            });
          }
          const payRec = wagePayments.find(w=>w.workerId===id && w.workerType==='driver' && w.date===dateStr);
          if(payRec) rows.push([t('lbl_payment_received'), rupee(payRec.amount)]);
          const advRec = advances.find(a=>a.workerType==='driver' && a.workerId===id && a.date===dateStr);
          if(advRec) rows.push([t('lbl_advance_received'), rupee(advRec.amount)]);
          if(!r && tasks.length===0 && !dn && !payRec && !advRec) return;
          showDayModal(niceDate, rows);
        } else {
          const r = attendance.find(a=>a.workerId===id && a.date===dateStr);
          if(!r) return;
          const stLbl = r.status==='P'?'✅ Full day':r.status==='H'?'🟡 Half day':'❌ Absent';
          const rows = [['Status', stLbl]];
          if(r.withDriverId || r.withDriverName){
            const drv = r.withDriverId ? driver.find(d=>d.id===r.withDriverId) : null;
            rows.push(['Site', '🚚 Driver ke saath: '+(drv?drv.name:(r.withDriverName||'—'))]);
            const cNote = companionNotes.find(n=>n.workerId===id && n.date===dateStr);
            if(cNote) rows.push([t('lbl_work_note'), cNote.note]);
          } else if(r.siteId==='elsewhere'){
            rows.push(['Site', '🔄 Kahin Aur Kaam Kiya']);
          } else {
            const site = sites.find(s=>s.id===r.siteId);
            rows.push(['Site', site?site.name:'—']);
          }
          const payRec = wagePayments.find(w=>w.workerId===id && w.workerType===kind && w.date===dateStr);
          if(payRec) rows.push([t('lbl_payment_received'), rupee(payRec.amount)]);
          const advRec = advances.find(a=>a.workerType===kind && a.workerId===id && a.date===dateStr);
          if(advRec) rows.push([t('lbl_advance_received'), rupee(advRec.amount)]);
          showDayModal(niceDate, rows);
        }
      });
    });

    document.querySelectorAll('[data-selectpay]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [type,pid] = el.dataset.selectpay.split('|');
        const isSame = state._selectedPay && state._selectedPay.type===type && state._selectedPay.id===pid;
        state._selectedPay = isSame ? null : {type, id:pid};
        render();
      });
    });
    document.querySelectorAll('[data-editpay]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const [type,pid] = el.dataset.editpay.split('|');
        state._editPay = {type, id:pid};
        render();
      });
    });
    document.querySelectorAll('[data-delpay]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const [type,pid] = el.dataset.delpay.split('|');
        showConfirmModal(t('confirm_delete_payment_entry'), ()=>{
          if(type==='wage'){ wagePayments = wagePayments.filter(w=>w.id!==pid); save(K.wagePayments, wagePayments); }
          else if(type==='adv'){ advances = advances.filter(a=>a.id!==pid); save(K.advances, advances); }
          else if(type==='sup'){ supPayments = supPayments.filter(p=>p.id!==pid); save(K.supPayments, supPayments); }
          state._selectedPay = null;
          render();
        });
      });
    });
    const editPaySaveBtn2 = document.getElementById('editPaySave');
    if(editPaySaveBtn2) editPaySaveBtn2.addEventListener('click', ()=>{
      const {type,id:pid} = state._editPay;
      const edate = document.getElementById('editPayDate').value;
      const eamount = parseFloat(document.getElementById('editPayAmt').value)||0;
      const enote = document.getElementById('editPayNote').value.trim();
      if(eamount<=0){ showInfoModal(t('msg_valid_amount')); return; }
      if(type==='wage'){ wagePayments = wagePayments.map(w=>w.id===pid?{...w,date:edate,amount:eamount,note:enote}:w); save(K.wagePayments, wagePayments); }
      else if(type==='adv'){ advances = advances.map(a=>a.id===pid?{...a,date:edate,amount:eamount,note:enote}:a); save(K.advances, advances); }
      else if(type==='sup'){ supPayments = supPayments.map(p=>p.id===pid?{...p,date:edate,amount:eamount,note:enote}:p); save(K.supPayments, supPayments); }
      state._editPay = null;
      render();
    });
    const editPayCancelBtn2 = document.getElementById('editPayCancel');
    if(editPayCancelBtn2) editPayCancelBtn2.addEventListener('click', ()=>{ state._editPay = null; render(); });

    const rateUpdateBtn = document.getElementById('rateUpdateSave');
    if(rateUpdateBtn) rateUpdateBtn.addEventListener('click', ()=>{
      const newVal = parseFloat(document.getElementById('rateNewVal').value)||0;
      const effDate = document.getElementById('rateEffDate').value;
      if(newVal<=0){ showInfoModal(t('msg_valid_amount')); return; }
      if(!effDate){ showInfoModal(t('msg_choose_eff_date')); return; }
      if(kind==='supervisor'){
        const hist = [...(p.salaryHistory||[]), {date:effDate, rate:newVal}];
        const updated = {...p, salaryHistory:hist, monthlySalary: currentRateFromHistory(hist, p.monthlySalary)};
        supervisor = supervisor.map(x=>x.id===p.id?updated:x);
        save(K.supervisor, supervisor);
      } else {
        const hist = [...(p.rateHistory||[]), {date:effDate, rate:newVal}];
        const updated = {...p, rateHistory:hist, rate: currentRateFromHistory(hist, p.rate)};
        if(kind==='majdoor'){ majdoor = majdoor.map(x=>x.id===p.id?updated:x); save(K.majdoor, majdoor); }
        else if(kind==='mistri'){ mistri = mistri.map(x=>x.id===p.id?updated:x); save(K.mistri, mistri); }
        else if(kind==='driver'){ driver = driver.map(x=>x.id===p.id?updated:x); save(K.driver, driver); }
      }
      render();
    });
  }

  // ===================== ATTENDANCE =====================
  function renderAttendance(){
    setTopbar(t('mark_attendance'), true);
    const date = state._attDate || todayStr();
    const siteId = state._attSite || (sites[0] ? sites[0].id : '');
    state._attDate = date; state._attSite = siteId;
    const isDriverTab = state._attTab==='driver';
    const isSupTab = state._attTab==='s';
    if(state._attTab==='s' && siteId==='elsewhere'){ state._attTab='majdoor'; }

    let html = `
      <div class="form-box" style="padding:12px;margin-bottom:14px;">
        <div class="row2">
          <input type="date" id="attDate" value="${date}">
          ${(isDriverTab||isSupTab) ? '' : `<select id="attSite" class="plain">
            ${sites.map(s=>`<option value="${s.id}" ${s.id===siteId?'selected':''}>${s.name}</option>`).join('')}
            <option value="elsewhere" ${siteId==='elsewhere'?'selected':''}>🔄 Kahin Aur Kaam Kiya</option>
          </select>`}
        </div>
      </div>
    `;
    if(sites.length===0 && !isDriverTab){
      app.innerHTML = html + `<div class="empty-state"><div class="display">Please add a site first</div></div>`;
      document.getElementById('attDate').addEventListener('change', function(){ state._attDate=this.value; render(); });
      return;
    }

    const dayRecs = isDriverTab ? attendance.filter(a=>a.date===date && a.workerType==='driver') : attendance.filter(a=>a.date===date);
    function statusFor(wid, kindFilter){
      let r;
      if((kindFilter==='majdoor'||kindFilter==='mistri') && isDualRoleWorker(wid)){
        r = dayRecs.find(a=>a.workerId===wid && (a.workerType==='majdoor'||a.workerType==='mistri'));
      } else {
        r = dayRecs.find(a=>a.workerId===wid && (!kindFilter || a.workerType===kindFilter));
      }
      return r?r.status:null;
    }

    html += `<div class="tabs">
      <div class="tab ${(!state._attTab||state._attTab==='majdoor')?'active':''}" data-atttab="majdoor">${t('labourers')}</div>
      <div class="tab ${state._attTab==='mistri'?'active':''}" data-atttab="mistri">${t('masons')}</div>
      <div class="tab ${state._attTab==='driver'?'active':''}" data-atttab="driver">${t('drivers')}</div>
      ${siteId!=='elsewhere' ? `<div class="tab ${state._attTab==='s'?'active':''}" data-atttab="s">${t('supervisors')}</div>` : ''}
    </div>`;

    if(state._attTab==='majdoor' || !state._attTab || state._attTab==='mistri' || state._attTab==='driver'){
      const kind = (state._attTab==='mistri'||state._attTab==='driver') ? state._attTab : 'majdoor';
      let list = WORKER_STORE[kind]().map(m=>({...m,kind})).filter(w=>!w.leftCompany);
      list = list.filter(w=>!w.isGuest || w.guestDate===date);
      const attQ = (state._attSearch && state._attSearch[kind] || '').trim().toLowerCase();
      if(attQ) list = list.filter(w=>w.name.toLowerCase().includes(attQ));
      // Sort: workers with no attendance marked yet today come first, marked ones sink to bottom
      list.sort((a,b)=>(isPayResolved(a.id,kind,date)?1:0)-(isPayResolved(b.id,kind,date)?1:0));
      if(!isDriverTab){
        const labourCount = attendance.filter(a=>a.date===date && a.workerType==='majdoor' && a.siteId===siteId).length;
        const masonCount = attendance.filter(a=>a.date===date && a.workerType==='mistri' && a.siteId===siteId).length;
        html += `<div class="meta" style="font-weight:700;color:var(--navy);margin-bottom:10px;">Labourers ${labourCount} · Masons ${masonCount}</div>`;
      }
      html += searchBarHtml('attSearch', `🔍 ${t('search_worker')}`, state._attSearch && state._attSearch[kind]);
      const statFilter = state._attStatusFilter || 'all';
      html += `<div style="display:flex;gap:6px;overflow-x:auto;margin-bottom:12px;">
        ${['all','present','half','absent'].map(f=>`<button type="button" class="chip-filter ${statFilter===f?'active':''}" data-attstatfilter="${f}">${f==='all'?t('lbl_all_word'):f==='present'?t('present'):f==='half'?t('half_day'):t('absent')}</button>`).join('')}
      </div>`;
      if(!isDriverTab){
        html += `<button type="button" class="btn-outline" id="markAllPresentBtn" style="margin-bottom:12px;">${t('lbl_mark_all_present')}</button>`;
      }
      if(statFilter!=='all'){
        list = list.filter(w=>{
          const st = statusFor(w.id, kind);
          if(statFilter==='present') return st==='P';
          if(statFilter==='half') return st==='H';
          if(statFilter==='absent') return st==='A';
          return true;
        });
      }
      if(isDriverTab){

      }
      if(list.length===0){
        html += attQ ? `<div class="empty-state"><div class="display">No match for "${state._attSearch[kind]}"</div></div>` : `<div class="empty-state"><div class="display">No ${WORKER_LABEL[kind].toLowerCase()}s added</div></div>`;
      } else {
        list.forEach(w=>{
          const st = statusFor(w.id, kind);
