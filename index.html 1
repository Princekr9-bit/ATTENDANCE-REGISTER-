          const editOpen = state._attEditOpen === kind+'|'+w.id;
          const isDual = (kind==='majdoor'||kind==='mistri') && w.dualRole;
          html += `<div class="card" style="cursor:default;${isDriverTab?'margin-bottom:0;border-bottom-left-radius:0;border-bottom-right-radius:0;':''}">
