              if(r.siteId==='elsewhere') return '🔄 Kahin Aur Kaam Kiya'+(r.status==='H' ? ' (½ day)' : '')+timeTag;
              const stObj = sites.find(s=>s.id===r.siteId);
              return stObj ? stObj.name + (r.status==='H' ? ' (½ day)' : '')+timeTag : '';
