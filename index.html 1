    if(!q){ resultsEl.innerHTML = `<div class="empty-state"><div class="display">${t('msg_type_to_search')}</div><div>${t('msg_search_hint')}</div></div>`; return; }
    const rows = [];
    majdoor.filter(w=>!w.leftCompany && w.name.toLowerCase().includes(q)).forEach(w=>rows.push({label:w.name, sub:'Labourer', nav:'personDetail', param:'majdoor|'+w.id}));
    mistri.filter(w=>!w.leftCompany && w.name.toLowerCase().includes(q)).forEach(w=>rows.push({label:w.name, sub:'Mason', nav:'personDetail', param:'mistri|'+w.id}));
    driver.filter(w=>!w.leftCompany && w.name.toLowerCase().includes(q)).forEach(w=>rows.push({label:w.name, sub:'Driver', nav:'personDetail', param:'driver|'+w.id}));
    supervisor.filter(w=>!w.leftCompany && w.name.toLowerCase().includes(q)).forEach(w=>rows.push({label:w.name, sub:'Supervisor', nav:'personDetail', param:'supervisor|'+w.id}));
