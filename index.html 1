<script>
(function(){
  // ===================== HASHING (works offline / non-HTTPS too) =====================
  async function hashText(str){
    try{
      if(window.isSecureContext && window.crypto && window.crypto.subtle){
        const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
        return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
      }
    }catch(e){}
    let h=0; for(let i=0;i<str.length;i++){ h=(Math.imul(31,h)+str.charCodeAt(i))|0; }
    return 'f'+Math.abs(h).toString(16);
  }

  // ===================== STORAGE =====================
  const K = {
    auth:'nm_auth',
    company:'nm_company', sites:'nm_sites', majdoor:'nm_majdoor', mistri:'nm_mistri',
    supervisor:'nm_supervisor', driver:'nm_driver', attendance:'nm_attendance', supAttendance:'nm_sup_attendance',
    advances:'nm_advances', supPayments:'nm_sup_payments', transactions:'nm_transactions',
    wagePayments:'nm_wage_payments', notes:'nm_notes', vehicles:'nm_vehicles', sitePhotos:'nm_site_photos',
    inventory:'nm_inventory', itemMoves:'nm_item_moves', lending:'nm_lending', custody:'nm_custody',
    driverNotes:'nm_driver_notes', udhar:'nm_udhar', rent:'nm_rent', attResolved:'nm_att_resolved', companionNotes:'nm_companion_notes', attLocked:'nm_att_locked', todos:'nm_todos', aiChat:'nm_ai_chat', personalTodos:'nm_personal_todos'
  };
  function load(key, fb){ try{ const v=JSON.parse(localStorage.getItem(key)); return v||fb; }catch(e){ return fb; } }

  // ===================== INDEXEDDB (for large media: site photos/videos) =====================
  // localStorage has only ~5-10MB total limit, which fills up fast with photos/videos.
  // IndexedDB has a much larger limit (hundreds of MB, device-dependent), so all large
  // media is stored there, and only a small reference id is kept in localStorage.
  const IDB_NAME = 'nm_media_db';
  const IDB_STORE = 'media';
  let _idbPromise = null;
  function idbOpen(){
    if(_idbPromise) return _idbPromise;
    _idbPromise = new Promise((resolve, reject)=>{
      if(!window.indexedDB){ reject(new Error('IndexedDB not supported')); return; }
      const req = indexedDB.open(IDB_NAME, 1);
      req.onupgradeneeded = ()=>{ req.result.createObjectStore(IDB_STORE); };
      req.onsuccess = ()=>resolve(req.result);
      req.onerror = ()=>reject(req.error);
    });
    return _idbPromise;
  }
  async function idbPut(id, data){
    const db = await idbOpen();
    return new Promise((resolve,reject)=>{
      const tx = db.transaction(IDB_STORE,'readwrite');
      tx.objectStore(IDB_STORE).put(data, id);
      tx.oncomplete = ()=>resolve();
      tx.onerror = ()=>reject(tx.error);
    });
  }
  async function idbGet(id){
    const db = await idbOpen();
    return new Promise((resolve,reject)=>{
      const tx = db.transaction(IDB_STORE,'readonly');
      const req = tx.objectStore(IDB_STORE).get(id);
      req.onsuccess = ()=>resolve(req.result);
      req.onerror = ()=>reject(req.error);
    });
  }
  async function idbGetAll(){
    const db = await idbOpen();
    return new Promise((resolve, reject)=>{
      const tx = db.transaction(IDB_STORE, 'readonly');
      const store = tx.objectStore(IDB_STORE);
      const out = {};
      const req = store.openCursor();
      req.onsuccess = (e)=>{
        const cursor = e.target.result;
        if(cursor){ out[cursor.key] = cursor.value; cursor.continue(); }
        else resolve(out);
      };
      req.onerror = ()=>reject(req.error);
    });
  }
  async function idbPutAll(mediaObj){
    const db = await idbOpen();
    return new Promise((resolve, reject)=>{
      const tx = db.transaction(IDB_STORE, 'readwrite');
      const store = tx.objectStore(IDB_STORE);
      Object.keys(mediaObj).forEach(id=>store.put(mediaObj[id], id));
      tx.oncomplete = ()=>resolve();
      tx.onerror = ()=>reject(tx.error);
    });
  }
  async function idbDelete(id){
    try{
      const db = await idbOpen();
      return new Promise((resolve)=>{
        const tx = db.transaction(IDB_STORE,'readwrite');
        tx.objectStore(IDB_STORE).delete(id);
        tx.oncomplete = ()=>resolve();
        tx.onerror = ()=>resolve();
      });
    }catch(e){}
  }
  async function hydrateMediaSlots(){
    const slots = document.querySelectorAll('.media-slot[data-media-id]');
    for(const slot of slots){
      const id = slot.dataset.mediaId;
      const type = slot.dataset.mediaType;
      try{
        const data = await idbGet(id);
        if(!data){ slot.textContent = '⚠️ Media not found (may have been cleared)'; continue; }
        if(type==='video'){
          slot.outerHTML = `<video src="${data}" controls style="width:100%;border-radius:8px;"></video>`;
        } else {
          slot.outerHTML = `<img src="${data}" style="width:100%;border-radius:8px;">`;
        }
      }catch(e){ slot.textContent = '⚠️ Error loading media'; }
    }
  }
  function save(key, v){ localStorage.setItem(key, JSON.stringify(v)); }

  // ===================== BACKUP / RESTORE =====================
  function ab2b64(buf){
    let binary=''; const bytes=new Uint8Array(buf); const chunk=0x8000;
    for(let i=0;i<bytes.length;i+=chunk){ binary += String.fromCharCode.apply(null, bytes.subarray(i,i+chunk)); }
    return btoa(binary);
  }
  function b642ab(b64){
    const binary = atob(b64); const bytes = new Uint8Array(binary.length);
    for(let i=0;i<binary.length;i++) bytes[i]=binary.charCodeAt(i);
    return bytes.buffer;
  }
  async function gzipStr(str){
    if(typeof CompressionStream==='undefined') return new TextEncoder().encode(str).buffer;
    const stream = new Blob([str]).stream().pipeThrough(new CompressionStream('gzip'));
    return await new Response(stream).arrayBuffer();
  }
  async function gunzipBuf(buf){
    if(typeof DecompressionStream==='undefined') return new TextDecoder().decode(buf);
    try{
      const stream = new Blob([buf]).stream().pipeThrough(new DecompressionStream('gzip'));
      return await new Response(stream).text();
    }catch(e){ return new TextDecoder().decode(buf); }
  }
  // Extra localStorage keys (outside the main K map) that should also be part of a
  // complete backup — app settings, preferences etc. Deliberately NOT included:
  // 'nm_sup_whatsapp' (supervisor name/number list for WhatsApp) and 'nm_gemini_key'
  // (AI assistant API key) — these stay device-local and are never backed up/restored.
  const EXTRA_BACKUP_KEYS = ['nm_notif_prefs', 'nm_dark_mode'];
  async function generateBackupCode(includeMedia){
    const ls = {};
    Object.keys(K).forEach(k=>{ ls[k] = localStorage.getItem(K[k]); });
    EXTRA_BACKUP_KEYS.forEach(rawKey=>{ ls['_extra_'+rawKey] = localStorage.getItem(rawKey); });
    const media = includeMedia ? await idbGetAll() : {};
    const payload = { v:1, exportedAt: new Date().toISOString(), hasMedia: !!includeMedia, ls, media };
    const json = JSON.stringify(payload);
    const compressed = await gzipStr(json);
    return ab2b64(compressed);
  }
  async function restoreFromBackupCode(code){
    const cleaned = code.replace(/\s+/g, '');
    const buf = b642ab(cleaned);
    const json = await gunzipBuf(buf);
    const payload = JSON.parse(json);
    Object.keys(payload.ls||{}).forEach(k=>{
      const val = payload.ls[k];
      if(val===null || val===undefined) return;
      if(K[k]) localStorage.setItem(K[k], val);
      else if(k.startsWith('_extra_')) localStorage.setItem(k.slice(7), val);
    });
    if(payload.media) await idbPutAll(payload.media);
  }
  function uid(){ return 'x'+Date.now()+Math.floor(Math.random()*1000); }

  function showConfirmModal(message, onConfirm, okLabel){
    const overlay = document.getElementById('confirmOverlay');
    document.getElementById('confirmMsg').textContent = message;
    const okBtn = document.getElementById('confirmOkBtn');
    const cancelBtn = document.getElementById('confirmCancelBtn');
    const iconEl = document.getElementById('confirmIcon');
    iconEl.textContent = '🗑️';
    cancelBtn.style.display = '';
    okBtn.textContent = okLabel || t('delete_word');
    overlay.style.display = 'flex';
    const cleanup = ()=>{
      overlay.style.display = 'none';
      okBtn.removeEventListener('click', onOk);
      cancelBtn.removeEventListener('click', onCancel);
    };
    const onOk = ()=>{ cleanup(); onConfirm(); };
    const onCancel = ()=>{ cleanup(); };
    okBtn.addEventListener('click', onOk);
    cancelBtn.addEventListener('click', onCancel);
  }

  function showInfoModal(message){
    const overlay = document.getElementById('confirmOverlay');
    document.getElementById('confirmMsg').textContent = message;
    const okBtn = document.getElementById('confirmOkBtn');
    const cancelBtn = document.getElementById('confirmCancelBtn');
    const iconEl = document.getElementById('confirmIcon');
    iconEl.textContent = 'ℹ️';
    cancelBtn.style.display = 'none';
    okBtn.textContent = t('ok_word');
    overlay.style.display = 'flex';
    const cleanup = ()=>{
      overlay.style.display = 'none';
      okBtn.removeEventListener('click', onOk);
      cancelBtn.style.display = '';
    };
    const onOk = ()=>{ cleanup(); };
    okBtn.addEventListener('click', onOk);
  }

  // ===================== SHORT CODE CLOUD BACKUP =====================
  function getFbDb(){
    if(!window.firebase) throw new Error(t('msg_firebase_failed'));
    if(!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
    return firebase.firestore();
  }
  function generateShortCode(){
    let n = '';
    for(let i=0;i<12;i++) n += Math.floor(Math.random()*10);
    return n;
  }
  function formatShortCode(code){
    return code.replace(/(\d{4})(?=\d)/g, '$1-');
  }
  async function pushTextBackupToCloud(){
    const db = getFbDb();
    const base64 = await generateBackupCode(false);
    let code = localStorage.getItem('nm_my_backup_code');
    if(!code){ code = generateShortCode(); localStorage.setItem('nm_my_backup_code', code); }
    const CHUNK_SIZE = 700000; // stay safely under Firestore's ~1MB per-document limit
    const chunks = [];
    for(let i=0;i<base64.length;i+=CHUNK_SIZE){ chunks.push(base64.slice(i, i+CHUNK_SIZE)); }
    const parentRef = db.collection('textBackups').doc(code);
    // Clear any old chunks from a previous (possibly different-length) backup first
    const oldChunks = await parentRef.collection('chunks').get();
    let batch = db.batch();
    oldChunks.forEach(d=>batch.delete(d.ref));
    if(!oldChunks.empty) await batch.commit();
    batch = db.batch();
    batch.set(parentRef, { chunkCount: chunks.length, updatedAt: new Date().toISOString() });
    chunks.forEach((chunk, i)=>{
      batch.set(parentRef.collection('chunks').doc(String(i)), { data: chunk });
    });
    await batch.commit();
    return code;
  }
  async function restoreTextBackupFromCloud(codeRaw){
    const db = getFbDb();
    const code = codeRaw.replace(/[^0-9]/g, '');
    if(code.length!==12) throw new Error('Code 12 digit ka hona chahiye.');
    const parentRef = db.collection('textBackups').doc(code);
    const doc = await parentRef.get();
    if(!doc.exists) throw new Error('Ye code nahi mila. Sahi likha hai check karo.');
    let full = '';
    if(doc.data() && doc.data().data){
      full = doc.data().data; // legacy single-document backup
    } else {
      const chunkSnap = await parentRef.collection('chunks').get();
      const parts = [];
      chunkSnap.forEach(d=>parts.push({ i: parseInt(d.id,10), data: d.data().data }));
      parts.sort((a,b)=>a.i-b.i);
      full = parts.map(p=>p.data).join('');
    }
    if(!full) throw new Error(t('err_backup_empty'));
    await restoreFromBackupCode(full);
    localStorage.setItem('nm_my_backup_code', code);
  }
  function rupee(n){ n = n||0; return '₹' + Math.round(n).toLocaleString('en-IN'); }
  function rupeeShort(n){
    n = n||0;
    const abs = Math.abs(n);
    if(abs>=10000000) return (n/10000000).toFixed(abs>=100000000?0:1)+'Cr';
    if(abs>=100000) return (n/100000).toFixed(abs>=1000000?0:1)+'L';
    if(abs>=1000) return (n/1000).toFixed(abs>=10000?0:1)+'K';
    return Math.round(n).toString();
  }
  function incExpBarHtml(income, expense){
    return `<div style="display:flex;gap:6px;margin-top:4px;">
      <div style="flex:1;background:var(--green-light);border-radius:6px;padding:3px 6px;text-align:center;">
        <div style="font-size:0.62rem;color:var(--ink-soft);">Income</div>
        <div style="font-size:0.8rem;font-weight:700;color:var(--green);">${rupee(income)}</div>
      </div>
      <div style="flex:1;background:var(--red-light);border-radius:6px;padding:3px 6px;text-align:center;">
        <div style="font-size:0.62rem;color:var(--ink-soft);">Expense</div>
        <div style="font-size:0.8rem;font-weight:700;color:var(--red);">${rupee(expense)}</div>
      </div>
    </div>`;
  }
  function todayStr(){ const d=new Date(); return d.getFullYear()+'-'+pad2(d.getMonth()+1)+'-'+pad2(d.getDate()); }
  function dispDate(dstr){ const d=new Date(dstr); if(isNaN(d)) return dstr; return d.toLocaleDateString(localeTag(),{day:'2-digit',month:'short',year:'numeric'}); }
  function monthKey(dstr){ return dstr.slice(0,7); }
  function shiftMonth(mk, delta){
    const [y,m] = mk.split('-').map(Number);
    const d = new Date(y, m-1+delta, 1);
    return d.getFullYear()+'-'+pad2(d.getMonth()+1);
  }
  function trendBadgeHtml(curr, prev){
    if(!prev || prev===0){
      if(curr>0) return `<span class="trend-badge up">▲ New</span>`;
      return '';
    }
    const pct = ((curr-prev)/Math.abs(prev))*100;
    const up = pct>=0;
    return `<span class="trend-badge ${up?'up':'down'}">${up?'▲':'▼'} ${Math.abs(pct).toFixed(1)}%</span>`;
  }
  function searchBarHtml(id, placeholder, value){
    return `<div class="modern-search-wrap">
      <svg class="ms-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="text" id="${id}" placeholder="${placeholder}" value="${(value||'').replace(/"/g,'&quot;')}">
    </div>`;
  }
  function statCardHtml(opts){
    return `<div class="stat-card" style="cursor:default;">
      <div class="stat-icon" style="background:${opts.bg};color:${opts.color};">${opts.icon}</div>
      <div class="stat-num">${opts.value}</div>
      <div class="stat-lbl">${opts.label}</div>
      ${opts.badge?`<div style="margin-top:6px;">${opts.badge}</div>`:''}
    </div>`;
