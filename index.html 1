      if(kind==='driver'){
        bodyHtml += `<div class="section-title">${t('attendance_work_log')}</div>`;
        bodyHtml += myAtt.length ? myAtt.slice(0,40).map(a=>{
          const st = a.status==='P'?'✅ '+t('full_day'):a.status==='H'?'🟡 '+t('half_day'):'❌ '+t('absent');
          const tasks = itemMoves.filter(m=>m.driverId===id && m.date===a.date);
          const dn = driverNotes.find(n=>n.driverId===id && n.date===a.date);
          const taskLbl = tasks.length ? tasks.map(m=>{ const it=inventory.find(x=>x.id===m.itemId); return it?it.name:'item'; }).join(', ') : '';
