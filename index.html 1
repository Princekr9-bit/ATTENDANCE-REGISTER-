  function buildTaskCalendarHtml(monthStr){
    const [y,m] = monthStr.split('-').map(Number);
    const firstDow = new Date(y, m-1, 1).getDay();
    const daysInMonth = new Date(y, m, 0).getDate();
    const dows = ['S','M','T','W','T','F','S'];
    const today = todayStr();
    let html = `<div class="cal-legend">
      <span><span class="dot" style="background:#2A5CA8;"></span> Today</span>
      <span><span class="dot" style="background:var(--red);"></span> Pending task</span>
      <span><span class="dot" style="background:var(--green);"></span> Completed</span>
    </div>`;
    html += `<div class="cal-grid">`;
    dows.forEach(d=>{ html += `<div class="cal-dow">${d}</div>`; });
    for(let i=0;i<firstDow;i++){ html += `<div class="cal-day blank"></div>`; }
    for(let d=1; d<=daysInMonth; d++){
      const dateStr = monthStr+'-'+pad2(d);
      const dayTasks = todos.filter(t=>t.date===dateStr);
      let style = '';
      if(dayTasks.length){
        const allDone = dayTasks.every(t=>t.done);
        style = allDone ? 'background:var(--green);color:#fff;' : 'background:var(--red);color:#fff;';
      }
      if(dateStr===today){ style += 'box-shadow:0 0 0 2px #2A5CA8 inset;font-weight:800;'+(dayTasks.length?'':'color:#2A5CA8;'); }
      html += `<div class="cal-day" data-date="${dateStr}" style="cursor:pointer;${style}">${d}</div>`;
    }
    html += `</div>`;
    return html;
  }

  function buildActivityCalendarHtml(monthStr, hasActivityForDay){
    const [y,m] = monthStr.split('-').map(Number);
    const firstDow = new Date(y, m-1, 1).getDay();
    const daysInMonth = new Date(y, m, 0).getDate();
    const dows = ['S','M','T','W','T','F','S'];
    let html = `<div class="cal-legend">
      <span><span class="dot" style="background:var(--navy2);"></span> Has records</span>
      <span><span class="dot" style="background:#EEF0F4;"></span> No records</span>
    </div>`;
    html += `<div class="cal-grid">`;
    dows.forEach(d=>{ html += `<div class="cal-dow">${d}</div>`; });
    for(let i=0;i<firstDow;i++){ html += `<div class="cal-day blank"></div>`; }
    for(let d=1; d<=daysInMonth; d++){
      const dateStr = monthStr+'-'+pad2(d);
      const has = hasActivityForDay(dateStr);
      html += `<div class="cal-day" data-date="${dateStr}" style="cursor:pointer;${has?'background:var(--navy2);color:#fff;':''}">${d}</div>`;
    }
    html += `</div>`;
    return html;
  }

  function renderDailyHistory(filterKind){
    const titleMap = {majdoor:'Labourers – Daily History', mistri:'Masons – Daily History', site:'Sites – Daily History'};
    setTopbar(titleMap[filterKind] || t('lbl_daily_record_history'), true);
    const cmonth = state._histMonth || todayStr().slice(0,7);
    state._histMonth = cmonth;

    const hasActivity = (dateStr)=>{
      if(filterKind==='majdoor' || filterKind==='mistri'){
        return attendance.some(a=>a.date===dateStr && a.workerType===filterKind && (a.status==='P'||a.status==='H'));
      }
      return attendance.some(a=>a.date===dateStr && (a.status==='P'||a.status==='H'));
    };
    const calHtml = buildActivityCalendarHtml(cmonth, hasActivity);

    let html = `<div class="form-box">
      <div class="cal-nav">
        <button id="histPrevBtn">‹</button>
        <input type="month" id="histMonthPicker" value="${cmonth}">
        <button id="histNextBtn">›</button>
      </div>
      ${calHtml}
      <div class="meta" style="text-align:center;margin-top:10px;color:var(--ink-soft);">Tap any date to see that day's record</div>
    </div>`;

    app.innerHTML = html;

    document.getElementById('histMonthPicker').addEventListener('change', function(){ state._histMonth=this.value; render(); });
    document.getElementById('histPrevBtn').addEventListener('click', ()=>{
      const [y,m] = cmonth.split('-').map(Number);
      const d = new Date(y, m-2, 1);
      state._histMonth = d.getFullYear()+'-'+pad2(d.getMonth()+1);
      render();
    });
    document.getElementById('histNextBtn').addEventListener('click', ()=>{
      const [y,m] = cmonth.split('-').map(Number);
      const d = new Date(y, m, 1);
      state._histMonth = d.getFullYear()+'-'+pad2(d.getMonth()+1);
      render();
    });
    document.querySelectorAll('.cal-day[data-date]').forEach(el=>{
      el.addEventListener('click', function(){
        const dateStr = this.dataset.date;
        const dayRecs = attendance.filter(a=>a.date===dateStr);

        if(filterKind==='majdoor'){
          const regularIds = new Set(majdoor.filter(p=>!p.isGuest).map(p=>p.id));
          const guestIds = new Set(majdoor.filter(p=>p.isGuest).map(p=>p.id));
          const presentIds = new Set(dayRecs.filter(a=>a.workerType==='majdoor' && (a.status==='P'||a.status==='H')).map(a=>a.workerId));
          const regularPresent = [...presentIds].filter(id=>regularIds.has(id)).length;
          const outsidePresent = [...presentIds].filter(id=>guestIds.has(id)).length;
          const absent = Math.max(0, regularIds.size - regularPresent);
          const rows = [
            [t('lbl_labourers_present'), regularPresent+' / '+regularIds.size],
            [t('absent'), absent]
          ];
          if(outsidePresent) rows.push([t('lbl_outside_labourers'), outsidePresent]);
          showDayModal(dispDate(dateStr), rows);
          return;
        }
        if(filterKind==='mistri'){
          const regularIds = new Set(mistri.filter(p=>!p.isGuest).map(p=>p.id));
          const guestIds = new Set(mistri.filter(p=>p.isGuest).map(p=>p.id));
          const presentIds = new Set(dayRecs.filter(a=>a.workerType==='mistri' && (a.status==='P'||a.status==='H')).map(a=>a.workerId));
          const regularPresent = [...presentIds].filter(id=>regularIds.has(id)).length;
          const outsidePresent = [...presentIds].filter(id=>guestIds.has(id)).length;
          const absent = Math.max(0, regularIds.size - regularPresent);
          const rows = [
            [t('lbl_masons_present'), regularPresent+' / '+regularIds.size],
            [t('absent'), absent]
          ];
          if(outsidePresent) rows.push([t('lbl_outside_masons'), outsidePresent]);
          showDayModal(dispDate(dateStr), rows);
          return;
        }
        if(filterKind==='site'){
          const siteIds = new Set(dayRecs.filter(a=>a.status==='P'||a.status==='H').map(a=>a.siteId));
          const siteNames = Array.from(siteIds).map(id=>{ const s=sites.find(x=>x.id===id); return s?s.name:'—'; }).join(', ') || '—';
          showDayModal(dispDate(dateStr), [
            [t('lbl_total_sites'), sites.length],
            [t('lbl_sites_working_that_day'), siteIds.size],
            [t('lbl_which_sites'), siteNames]
          ]);
          return;
        }

        const labourerIds = new Set(dayRecs.filter(a=>a.workerType==='majdoor' && (a.status==='P'||a.status==='H')).map(a=>a.workerId));
        const masonIds = new Set(dayRecs.filter(a=>a.workerType==='mistri' && (a.status==='P'||a.status==='H')).map(a=>a.workerId));
        const driverIds = new Set(dayRecs.filter(a=>a.workerType==='driver' && (a.status==='P'||a.status==='H')).map(a=>a.workerId));
        const siteIds = new Set(dayRecs.filter(a=>a.status==='P'||a.status==='H').map(a=>a.siteId));
        const siteNames = Array.from(siteIds).map(id=>{ const s=sites.find(x=>x.id===id); return s?s.name:'—'; }).join(', ') || '—';
        showDayModal(dispDate(dateStr), [
          [t('lbl_labourers_present'), labourerIds.size],
          [t('lbl_masons_present'), masonIds.size],
          [t('lbl_drivers_present'), driverIds.size],
          [t('lbl_sites_working2'), siteIds.size],
          [t('lbl_which_sites'), siteNames]
        ]);
      });
    });
  }

