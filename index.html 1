          const locked = isAttLocked(w.id, kind, date);
          const relevantForPay = (st==='P'||st==='H');
          const isElsewhereRec = workerRecs.some(r=>r.siteId==='elsewhere');
          const resolved = relevantForPay && isPayResolved(w.id, kind, date);
          const wasPaid = resolved && wasPaidToday(w.id, kind, date);
          const showBadge = st && locked;
          let badgeText = '';
          if(showBadge){
            badgeText = st==='P'?'🔒 Full day':st==='H'?'🔒 Half day':'🔒 Absent';
            if(resolved) badgeText += isElsewhereRec ? ' · ✓ Paid Elsewhere' : (wasPaid ? ' · ✓ Paid' : ' · ✕ Not paid');
