            if((rec.status==='P'||rec.status==='H') && !compResolved){
              html += `<div style="margin:-6px 0 10px;display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap;">
                <button class="mini-btn skip" data-notpay="${rec.workerType}|${w.id}">${t('btn_not_pay_today')}</button>
                <button class="mini-btn ok" data-payquick="${rec.workerType}|${w.id}">💰 Pay Now</button>
              </div>`;
            }
            html += `<div style="text-align:right;margin:-4px 0 14px;"><button type="button" class="icon-btn delete" data-deldrvcomp="${rec.id}">${TRASH_SVG}</button></div>`;
          });
        }
      }
      if(isDriverTab){
        const todaysMoves = itemMoves.filter(m=>m.date===date && m.driverId);
        html += `<div class="section-title">📦 Item Movements Logged Today</div>`;
        html += todaysMoves.length ? todaysMoves.map(m=>{
          const it = inventory.find(x=>x.id===m.itemId);
          const drv = driver.find(x=>x.id===m.driverId);
          const from = m.fromSiteId ? (sites.find(s=>s.id===m.fromSiteId)||{}).name : t('company_warehouse');
          const to = m.toSiteId ? (sites.find(s=>s.id===m.toSiteId)||{}).name : t('company_warehouse');
          return `<div class="list-row"><div><div class="l1">${it?it.name:'—'}</div><div class="l2">${drv?drv.name:'—'} · ${from||'—'} → ${to||'—'}</div></div></div>`;
        }).join('') : `<div class="meta" style="color:var(--ink-soft);">No item movement logged for this date yet.</div>`;
        html += `<button class="btn-outline" data-nav="inventory">📦 Go to Saman (Inventory) to log a movement</button>`;
      }
    } else {
      const supDayRecs = supAttendance.filter(a=>a.date===date);
      function supStatus(sid){ const r=supDayRecs.find(a=>a.supId===sid); return r?r.status:null; }
      if(supervisor.length===0){
        html += `<div class="empty-state"><div class="display">No supervisors added</div></div>`;
      } else {
        const supList = [...supervisor].filter(sp=>!sp.leftCompany).sort((a,b)=>(isPayResolved(a.id,'supervisor',date)?1:0)-(isPayResolved(b.id,'supervisor',date)?1:0));
        supList.forEach(sp=>{
          const st = supStatus(sp.id);
          const locked = isAttLocked(sp.id, 'supervisor', date);
          const supResolved = st==='P' && isPayResolved(sp.id,'supervisor',date);
          const supPaid = supResolved && supPayments.some(p=>p.date===date && p.supId===sp.id);
          const showBadge = st && locked;
          let badgeText = '';
          if(showBadge){
            badgeText = st==='P'?'🔒 Full day':'🔒 Absent';
            if(supResolved) badgeText += supPaid ? ' · ✓ Paid' : ' · ✕ Not paid';
          }
          const petrolToday = transactions.find(t=>t.category==='petrol' && t.supId===sp.id && t.date===date);
          const rowActionsOpen = state._attEditOpen === 'supervisor|'+sp.id;
          const hasActions = locked || !!petrolToday;
          let petrolInline = '';
          if(st){
            if(!petrolToday){
              petrolInline = `<div class="petrol-inline petrol-inline-edit">
                <label>⛽ ${t('today_petrol')} (₹)</label>
                <div class="petrol-inline-form">
                  <input type="number" id="petrolAmt_${sp.id}" placeholder="${t('amount')}">
                  <button class="mini-btn ok" data-petrolsave="${sp.id}">${t('save')}</button>
                </div>
              </div>`;
            } else if(state._petrolEditId===petrolToday.id){
              petrolInline = `<div class="petrol-inline petrol-inline-edit">
                <label>⛽ ${t('today_petrol')} (₹)</label>
                <div class="petrol-inline-form">
                  <input type="number" id="petrolAmt_${sp.id}" value="${petrolToday.amount}" placeholder="${t('amount')}">
                  <button class="mini-btn ok" data-petrolsave="${sp.id}">${t('save')}</button>
                </div>
              </div>`;
            } else {
              petrolInline = `<div class="petrol-inline">
                <div class="petrol-inline-info"><span>⛽ ${t('today_petrol')}</span><strong>₹${petrolToday.amount}</strong></div>
              </div>`;
            }
          }
          html += `<div class="card sup-att-card" style="cursor:default;">
            <div class="sup-att-row">
              ${avatarHtml(sp.photo, sp.name)}
              <div class="info">
                <div class="title">${sp.name}</div>
                <div class="meta">${t('monthly_salary')}</div>
                ${showBadge?`<span class="lock-tag" data-attlocktap="supervisor|${sp.id}">${badgeText}</span>`:''}
              </div>
              <div class="stamp-row ${locked?'locked':''}">
                <div class="stamp ${st==='P'?'on-P':''}" data-supmark="${sp.id}|P">P</div>
                <div class="stamp ${st==='A'?'on-A':''}" data-supmark="${sp.id}|A">A</div>
              </div>
            </div>
            ${petrolInline}
            ${(hasActions && rowActionsOpen)?`<div class="sup-row-actions">
              <button type="button" class="icon-btn edit" data-supcardedit="${sp.id}">${PENCIL_SVG}</button>
              ${petrolToday?`<button type="button" class="icon-btn delete" data-petroldel="${petrolToday.id}|${sp.id}">${TRASH_SVG}</button>`:''}
            </div>`:''}
          </div>`;
        });
      }
    }

    app.innerHTML = html;

    document.getElementById('attDate').addEventListener('change', function(){ state._attDate=this.value; render(); });
    const attSiteEl = document.getElementById('attSite');
    if(attSiteEl) attSiteEl.addEventListener('change', function(){ state._attSite=this.value; render(); });
    const attSearchEl = document.getElementById('attSearch');
    if(attSearchEl) attSearchEl.addEventListener('input', function(){
      const kind = (state._attTab==='mistri'||state._attTab==='driver') ? state._attTab : 'majdoor';
      state._attSearch = state._attSearch || {};
      state._attSearch[kind] = this.value;
      render();
      const el = document.getElementById('attSearch');
      if(el){ el.focus(); el.selectionStart = el.selectionEnd = el.value.length; }
    });
    document.querySelectorAll('[data-attstatfilter]').forEach(el=>{
      el.addEventListener('click', ()=>{ state._attStatusFilter = el.dataset.attstatfilter; render(); });
    });
    const markAllBtn = document.getElementById('markAllPresentBtn');
    if(markAllBtn) markAllBtn.addEventListener('click', ()=>{
      const kind = (state._attTab==='mistri'||state._attTab==='driver') ? state._attTab : 'majdoor';
      let list = WORKER_STORE[kind]().map(m=>({...m,kind})).filter(w=>!w.leftCompany);
      list = list.filter(w=>!w.isGuest || w.guestDate===date);
      let count = 0;
      list.forEach(w=>{
        if(isAttLocked(w.id, kind, date)) return;
        const existing = attendance.find(a=>a.date===date && a.workerId===w.id && a.workerType===kind && a.siteId===siteId);
        if(existing) return;
        attendance.push({id:uid(), date, siteId, workerId:w.id, workerType:kind, status:'P'});
        lockAttendance(w.id, kind, date);
        count++;
      });
      save(K.attendance, attendance);
      showInfoModal(count>0 ? `✅ ${count} ${t('msg_marked_present')}` : t('msg_all_already_marked'));
      render();
    });
    document.querySelectorAll('[data-atttab]').forEach(el=>{
      el.addEventListener('click', ()=>{ state._attTab=el.dataset.atttab; render(); });
    });
    document.querySelectorAll('[data-mark]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [kind,wid,status] = el.dataset.mark.split('|');
        if(isAttLocked(wid, kind, date)) return;
        const markSiteId = kind==='driver' ? null : siteId;
        const isDual = (kind==='majdoor'||kind==='mistri') && isDualRoleWorker(wid);
        const existingIdx = attendance.findIndex(a=>a.date===date && a.workerId===wid && (kind==='driver' ? a.workerType==='driver' : (isDual ? (a.workerType==='majdoor'||a.workerType==='mistri') : a.workerType===kind) && a.siteId===siteId));

        // Toggling off or changing status at the SAME site - no conflict check needed
        const isRemoving = existingIdx>-1 && attendance[existingIdx].status===status;

        if(!isRemoving && kind!=='driver'){
          // Check if this worker already has attendance marked at a DIFFERENT site on this date (same role only, unless dual-role)
          const elsewhere = attendance.find(a=>a.workerId===wid && a.date===date && (isDual ? (a.workerType==='majdoor'||a.workerType==='mistri') : a.workerType===kind) && a.siteId!==siteId);
          if(elsewhere){
            const otherSite = sites.find(s=>s.id===elsewhere.siteId);
            const otherSiteName = otherSite ? otherSite.name : 'another site';
            if(elsewhere.status==='P'){
              showInfoModal(t('msg_already_full_day')+otherSiteName+' for this date. A worker cannot be marked at two sites for a full day.');
              return;
            }
            if(elsewhere.status==='H' && status!=='H'){
              showInfoModal(t('msg_already_half_day')+otherSiteName+' for this date. You can only mark Half Day here too (not Full Day).');
              return;
            }
          }
        }

        if(existingIdx>-1 && attendance[existingIdx].status===status){
          attendance.splice(existingIdx,1);
          unlockAttendance(wid, kind, date);
        } else if(existingIdx>-1){
          attendance[existingIdx].status = status;
          attendance[existingIdx].checkinTime = attendance[existingIdx].checkinTime || new Date().toLocaleTimeString(localeTag(),{hour:'2-digit',minute:'2-digit'});
          lockAttendance(wid, kind, date);
        } else {
          attendance.push({id:uid(), date, siteId:markSiteId, workerId:wid, workerType:kind, status, checkinTime:new Date().toLocaleTimeString(localeTag(),{hour:'2-digit',minute:'2-digit'})});
          lockAttendance(wid, kind, date);
        }
        save(K.attendance, attendance);
        render();
      });
    });
    document.querySelectorAll('[data-payquick]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [kind,wid] = el.dataset.payquick.split('|');
