            <div class="info">
              <div class="title">${w.name} ${isDual?'<span class="badge" style="background:#DDE9FF;color:#2A5CA8;">Labour+Mason</span>':''} ${w.isGuest?'<span class="badge">Outside</span>':''}</div>
