  function attachPatternGrid(containerId, onComplete){
    const container = document.getElementById(containerId);
    if(!container) return;
    const wrap = container.parentElement;
    const svg = document.getElementById(containerId+'_svg');
    let path = [];
    let dragging = false;
    let centers = [];

    function computeCenters(){
      const wrapRect = wrap.getBoundingClientRect();
      svg.setAttribute('width', wrapRect.width);
      svg.setAttribute('height', wrapRect.height);
      svg.setAttribute('viewBox', `0 0 ${wrapRect.width} ${wrapRect.height}`);
      centers = Array.from(container.querySelectorAll('.pattern-dot')).map(dot=>{
        const r = dot.getBoundingClientRect();
        return { x: r.left + r.width/2 - wrapRect.left, y: r.top + r.height/2 - wrapRect.top };
      });
    }
    computeCenters();

    function reset(){
      path = [];
      container.querySelectorAll('.pattern-dot').forEach(d=>d.classList.remove('active'));
      svg.innerHTML = '';
    }
    function segSvg(a,b){
      return `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" class="pattern-line-glow"/><line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" class="pattern-line-core"/>`;
    }
    function drawLines(livePoint){
      let html = '';
      for(let i=0;i<path.length-1;i++){ html += segSvg(centers[path[i]], centers[path[i+1]]); }
      if(livePoint && path.length){ html += segSvg(centers[path[path.length-1]], livePoint); }
      svg.innerHTML = html;
    }
    function addDot(dot){
      const idx = parseInt(dot.dataset.idx,10);
      if(!path.includes(idx)){ path.push(idx); dot.classList.add('active'); drawLines(); }
    }
    container.addEventListener('pointerdown', e=>{
      const dot = e.target.closest('.pattern-dot');
      if(!dot) return;
      computeCenters();
      dragging = true;
      reset();
      addDot(dot);
    });
    container.addEventListener('pointermove', e=>{
      if(!dragging) return;
      const wrapRect = wrap.getBoundingClientRect();
      const el = document.elementFromPoint(e.clientX, e.clientY);
      const dot = el && el.closest ? el.closest('.pattern-dot') : null;
      if(dot && container.contains(dot)) addDot(dot);
      drawLines({x: e.clientX-wrapRect.left, y: e.clientY-wrapRect.top});
    });
    window.addEventListener('pointerup', function handler(){
      if(!dragging) return;
      dragging = false;
      drawLines();
      if(path.length>=4){ const p=path.slice(); onComplete(p); setTimeout(reset, 250); }
      else { reset(); }
    });
  }

