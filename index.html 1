  let _active3dStop = null;
  function init3dSiteViewer(container, rooms){
    if(!container || typeof THREE==='undefined') return;
    if(_active3dStop) { _active3dStop(); _active3dStop = null; }
    container.innerHTML = '';
    const W = container.clientWidth || 320, H = container.clientHeight || 320;
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x1A2333);
    const camera = new THREE.PerspectiveCamera(50, W/H, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({antialias:true});
    renderer.setSize(W, H);
    container.appendChild(renderer.domElement);

    const ambient = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambient);
    const dir = new THREE.DirectionalLight(0xffffff, 0.6);
    dir.position.set(5, 10, 5);
    scene.add(dir);

    const grid = new THREE.GridHelper(30, 30, 0x444a5c, 0x2A3547);
    scene.add(grid);

    const colors = [0xE8622C, 0x2A5CA8, 0x2E8B57, 0xD69F2E, 0x8E7CC3, 0xC1442D];
    let maxExtent = 8;
    (rooms||[]).forEach((r,i)=>{
      const geo = new THREE.BoxGeometry(r.w, r.h, r.d);
      const mat = new THREE.MeshStandardMaterial({color: colors[i%colors.length], transparent:true, opacity:0.85});
      const box = new THREE.Mesh(geo, mat);
      box.position.set(r.x + r.w/2, r.h/2, r.y + r.d/2);
      scene.add(box);
      const edges = new THREE.EdgesGeometry(geo);
      const line = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({color:0xffffff}));
      line.position.copy(box.position);
      scene.add(line);
      maxExtent = Math.max(maxExtent, Math.abs(r.x)+r.w, Math.abs(r.y)+r.d);
    });

    let radius = maxExtent*1.8, theta = Math.PI/4, phi = Math.PI/3.2;
    function updateCam(){
      camera.position.set(
        radius*Math.sin(phi)*Math.cos(theta),
        radius*Math.cos(phi),
        radius*Math.sin(phi)*Math.sin(theta)
      );
      camera.lookAt(0,0,0);
    }
    updateCam();

    let dragging=false, lastX=0, lastY=0;
    function onDown(x,y){ dragging=true; lastX=x; lastY=y; }
    function onMove(x,y){
      if(!dragging) return;
      theta -= (x-lastX)*0.01;
      phi = Math.max(0.2, Math.min(Math.PI/2-0.05, phi - (y-lastY)*0.01));
      lastX=x; lastY=y;
      updateCam();
    }
    function onUp(){ dragging=false; }
    renderer.domElement.addEventListener('mousedown', e=>onDown(e.clientX,e.clientY));
    window.addEventListener('mousemove', e=>onMove(e.clientX,e.clientY));
    window.addEventListener('mouseup', onUp);
    let pinching=false, pinchStartDist=0, pinchStartRadius=radius;
    function touchDist(t0,t1){ return Math.hypot(t1.clientX-t0.clientX, t1.clientY-t0.clientY); }
    renderer.domElement.addEventListener('touchstart', e=>{
      if(e.touches.length===2){
        pinching=true; dragging=false;
        pinchStartDist = touchDist(e.touches[0], e.touches[1]);
        pinchStartRadius = radius;
      } else {
        pinching=false;
        const t=e.touches[0]; onDown(t.clientX,t.clientY);
      }
    }, {passive:true});
    renderer.domElement.addEventListener('touchmove', e=>{
      if(pinching && e.touches.length===2){
        const d = touchDist(e.touches[0], e.touches[1]);
        radius = Math.max(3, Math.min(maxExtent*4, pinchStartRadius * (pinchStartDist/(d||1))));
        updateCam();
      } else if(!pinching){
        const t=e.touches[0]; onMove(t.clientX,t.clientY);
      }
      e.preventDefault();
    }, {passive:false});
    renderer.domElement.addEventListener('touchend', e=>{ if(e.touches.length<2) pinching=false; onUp(); });
    renderer.domElement.addEventListener('wheel', e=>{ e.preventDefault(); radius = Math.max(3, Math.min(maxExtent*4, radius + e.deltaY*0.02)); updateCam(); }, {passive:false});

    let stopped = false;
    function animate(){
      if(stopped) return;
      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }
    animate();
    container._stopAnim = ()=>{ stopped = true; };
    _active3dStop = container._stopAnim;
  }

  let _active3dFileRenderer = null;
  function init3dFileViewer(container, site){
    if(!container || typeof THREE==='undefined' || typeof THREE.GLTFLoader==='undefined') return;
    if(_active3dStop) { _active3dStop(); _active3dStop = null; }
    _active3dFileRenderer = null;
    container.innerHTML = '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#AEB9CE;font-size:0.8rem;">' + t('model_loading') + '</div>';
    const W = container.clientWidth || 320, H = container.clientHeight || 320;

    idbGet(site.model3dId).then(dataUrl=>{
      if(!dataUrl){ container.innerHTML = '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#AEB9CE;font-size:0.8rem;">' + t('msg_model_not_found') + '</div>'; return; }
      container.innerHTML = '';
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x1A2333);
      const camera = new THREE.PerspectiveCamera(50, W/H, 0.1, 2000);
      const renderer = new THREE.WebGLRenderer({antialias:true, preserveDrawingBuffer:true});
      renderer.setSize(W, H);
      container.appendChild(renderer.domElement);
      _active3dFileRenderer = renderer;

      const ambient = new THREE.AmbientLight(0xffffff, 0.85);
      scene.add(ambient);
      const dir = new THREE.DirectionalLight(0xffffff, 0.7);
      dir.position.set(5, 10, 5);
      scene.add(dir);
      const dir2 = new THREE.DirectionalLight(0xffffff, 0.4);
      dir2.position.set(-5, 5, -5);
      scene.add(dir2);

      const base64 = dataUrl.split(',')[1];
      const binary = atob(base64);
      const bytes = new Uint8Array(binary.length);
      for(let i=0;i<binary.length;i++) bytes[i] = binary.charCodeAt(i);

      const loader = new THREE.GLTFLoader();
      loader.parse(bytes.buffer, '', (gltf)=>{
        const modelRoot = gltf.scene;
        scene.add(modelRoot);

        const box = new THREE.Box3().setFromObject(modelRoot);
        const size = new THREE.Vector3(); box.getSize(size);
        const center = new THREE.Vector3(); box.getCenter(center);
        modelRoot.position.sub(center);
        const maxDim = Math.max(size.x, size.y, size.z, 0.5);

        const markerGroup = new THREE.Group();
        scene.add(markerGroup);
        function addMarkerMesh(pos){
          const geo = new THREE.SphereGeometry(maxDim*0.02, 12, 12);
          const mat = new THREE.MeshBasicMaterial({color:0xE8362C});
          const sph = new THREE.Mesh(geo, mat);
          sph.position.copy(pos);
          markerGroup.add(sph);
        }
        (site.model3dMarkers||[]).forEach(m=>addMarkerMesh(new THREE.Vector3(m.x, m.y, m.z)));

        let radius = maxDim*2.2, theta = Math.PI/4, phi = Math.PI/3.2;
        function updateCam(){
          camera.position.set(
            radius*Math.sin(phi)*Math.cos(theta),
            radius*Math.cos(phi),
            radius*Math.sin(phi)*Math.sin(theta)
          );
          camera.lookAt(0,0,0);
        }
        updateCam();

        let dragging=false, lastX=0, lastY=0, downX=0, downY=0, downTime=0, moved=false;
        function onDown(x,y){ dragging=true; lastX=x; lastY=y; downX=x; downY=y; downTime=Date.now(); moved=false; }
        function onMove(x,y){
          if(!dragging) return;
          if(Math.abs(x-downX)>6 || Math.abs(y-downY)>6) moved = true;
          theta -= (x-lastX)*0.01;
          phi = Math.max(0.15, Math.min(Math.PI/2-0.05, phi - (y-lastY)*0.01));
          lastX=x; lastY=y;
          updateCam();
        }
        function raycastTap(clientX, clientY){
          const rect = renderer.domElement.getBoundingClientRect();
          const mouse = new THREE.Vector2(
            ((clientX-rect.left)/rect.width)*2 - 1,
            -((clientY-rect.top)/rect.height)*2 + 1
          );
          const raycaster = new THREE.Raycaster();
          raycaster.setFromCamera(mouse, camera);
          const hits = raycaster.intersectObject(modelRoot, true);
          if(hits.length){
            const p = hits[0].point;
            addMarkerMesh(p);
            const markers = [...(site.model3dMarkers||[]), {x:p.x, y:p.y, z:p.z}];
            site.model3dMarkers = markers;
            sites = sites.map(x=>x.id===site.id ? {...x, model3dMarkers: markers} : x);
            save(K.sites, sites);
          }
        }
        function onUp(x,y){
          if(dragging && !moved && (Date.now()-downTime)<400 && typeof x==='number'){
            raycastTap(x,y);
          }
          dragging=false;
        }
        renderer.domElement.addEventListener('mousedown', e=>onDown(e.clientX,e.clientY));
        window.addEventListener('mousemove', e=>onMove(e.clientX,e.clientY));
        window.addEventListener('mouseup', e=>onUp(e.clientX,e.clientY));
        let pinching=false, pinchStartDist=0, pinchStartRadius=radius;
        function touchDist(t0,t1){ return Math.hypot(t1.clientX-t0.clientX, t1.clientY-t0.clientY); }
        renderer.domElement.addEventListener('touchstart', e=>{
          if(e.touches.length===2){
            pinching=true; dragging=false;
            pinchStartDist = touchDist(e.touches[0], e.touches[1]);
            pinchStartRadius = radius;
          } else {
            pinching=false;
            const t=e.touches[0]; onDown(t.clientX,t.clientY);
          }
        }, {passive:true});
        renderer.domElement.addEventListener('touchmove', e=>{
          if(pinching && e.touches.length===2){
            const d = touchDist(e.touches[0], e.touches[1]);
            radius = Math.max(maxDim*0.5, Math.min(maxDim*8, pinchStartRadius * (pinchStartDist/(d||1))));
            updateCam();
          } else if(!pinching){
            const t=e.touches[0]; onMove(t.clientX,t.clientY);
          }
          e.preventDefault();
        }, {passive:false});
        renderer.domElement.addEventListener('touchend', e=>{
          if(e.touches.length<2) pinching=false;
          const t = e.changedTouches && e.changedTouches[0];
          onUp(t?t.clientX:undefined, t?t.clientY:undefined);
        });
        renderer.domElement.addEventListener('wheel', e=>{ e.preventDefault(); radius = Math.max(maxDim*0.5, Math.min(maxDim*8, radius + e.deltaY*0.02*maxDim*0.1)); updateCam(); }, {passive:false});

        let stopped = false;
        function animate(){
          if(stopped) return;
          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        }
        animate();
        container._stopAnim = ()=>{ stopped = true; _active3dFileRenderer = null; };
        _active3dStop = container._stopAnim;
      }, (err)=>{
        container.innerHTML = '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#E8362C;font-size:0.8rem;text-align:center;padding:0 16px;">' + t('msg_model_load_failed') + '</div>';
      });
    });
  }

