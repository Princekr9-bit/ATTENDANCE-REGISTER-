  // ---------- Wage ledger helper (majdoor/mistri only) ----------
  function rateOnDate(history, fallbackRate, dateStr){
    if(!history || !history.length) return fallbackRate||0;
    const sorted = [...history].sort((a,b)=>a.date.localeCompare(b.date));
    let applicable = sorted[0].rate;
    for(const h of sorted){
      if(h.date<=dateStr) applicable = h.rate; else break;
    }
    return applicable;
  }
  function currentRateFromHistory(history, fallback){
    if(!history || !history.length) return fallback||0;
    return [...history].sort((a,b)=>a.date.localeCompare(b.date)).slice(-1)[0].rate;
  }
  function computeWageLedger(kind, workerId, person, uptoMonth){
    // uptoMonth optional 'YYYY-MM' - if given, only includes records up to end of that month
    const history = person && person.rateHistory;
    const fallbackRate = person ? (person.rate||0) : 0;
    const attFilter = a => a.workerId===workerId && a.siteId!=='elsewhere' && (!uptoMonth || monthKey(a.date)<=uptoMonth);
    const payFilter = w => w.workerId===workerId && (!uptoMonth || monthKey(w.date)<=uptoMonth);
    const advFilter = a => a.workerType===kind && a.workerId===workerId && (!uptoMonth || monthKey(a.date)<=uptoMonth);
    const earned = attendance.filter(attFilter).reduce((sum,a)=>{
      const r = rateOnDate(history, fallbackRate, a.date);
      if(a.status==='P') return sum+r;
      if(a.status==='H') return sum+r/2;
      return sum;
    },0);
    const paidWage = wagePayments.filter(payFilter).reduce((s,w)=>s+w.amount,0);
    const paidAdvance = advances.filter(advFilter).reduce((s,a)=>s+a.amount,0);
    const received = paidWage + paidAdvance;
    return { earned, paidWage, paidAdvance, received, balance: earned - received };
  }

