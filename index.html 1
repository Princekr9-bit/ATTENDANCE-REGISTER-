              ${cNote?'<span class="meta" style="color:var(--green);margin-left:8px;">✅ Saved</span>':''}
            </div>`;
            if(showBadge && editOpen){
              html += `<div style="margin:-6px 0 10px;display:flex;justify-content:flex-end;"><button type="button" class="icon-btn edit" data-editallcomp="${rec.workerType}|${w.id}">${PENCIL_SVG}</button></div>`;
