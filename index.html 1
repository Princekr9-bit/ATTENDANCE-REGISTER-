        if(siteId==='ALL'){
          const wageMo = wagePayments.filter(w=>monthKey(w.date)===mk).reduce((a,b)=>a+b.amount,0);
          const advMo = advances.filter(a=>monthKey(a.date)===mk).reduce((a,b)=>a+b.amount,0);
          const supMo = supPayments.filter(s=>monthKey(s.date)===mk).reduce((a,b)=>a+b.amount,0);
          exp += wageMo + advMo + supMo;
          catWage += wageMo + advMo + supMo;
        }
        monthsData.push({label: new Date(plYear,mo-1,1).toLocaleDateString(localeTag(),{month:'short'}), inc, exp});
        yearIncome += inc; yearExpense += exp;
      }
      const maxV = Math.max(1, ...monthsData.map(m=>Math.max(m.inc,m.exp)));
      const netProfit = yearIncome - yearExpense;

      let prevYearIncome=0, prevYearExpense=0;
      for(let mo=1; mo<=12; mo++){
        const pmk = (plYear-1)+'-'+pad2(mo);
        const plist = siteId==='ALL' ? transactions.filter(t=>monthKey(t.date)===pmk) : transactions.filter(t=>monthKey(t.date)===pmk && t.siteId===siteId);
        prevYearIncome += plist.filter(t=>t.type==='income').reduce((a,b)=>a+b.amount,0);
        let pexp = plist.filter(t=>t.type==='expense').reduce((a,b)=>a+b.amount,0);
        if(siteId==='ALL'){
          pexp += wagePayments.filter(w=>monthKey(w.date)===pmk).reduce((a,b)=>a+b.amount,0);
          pexp += advances.filter(a=>monthKey(a.date)===pmk).reduce((a,b)=>a+b.amount,0);
