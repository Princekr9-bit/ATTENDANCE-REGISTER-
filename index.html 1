      } else {
        // Site Visit Log removed — full date-wise detail is available by tapping any date in the Attendance Calendar above.
      }
      bodyHtml += `<div class="section-title">${t('work_payment_history')} <span style="font-size:0.72rem;font-weight:400;color:var(--ink-soft);">${t('last_7_days_note')}</span></div>`;
      const weekAgo = new Date(); weekAgo.setDate(weekAgo.getDate()-7);
      const weekAgoStr = weekAgo.toISOString().slice(0,10);
      const myWageWeek = myWage.filter(w=>w.date>=weekAgoStr);
      bodyHtml += myWageWeek.length ? myWageWeek.map(w=>{
        if(state._editPay && state._editPay.type==='wage' && state._editPay.id===w.id){
          return `<div class="form-box" style="margin-bottom:10px;">
            <label>${t('date_label')}</label><input type="date" id="editPayDate" value="${w.date}">
            <label>${t('amount')} (₹)</label><input type="number" id="editPayAmt" value="${w.amount}">
