  const FIREBASE_CONFIG = {
    apiKey: "AIzaSyCP1yuIb2r6aKTq13evyMA6ZjTHLFaFJ10",
    authDomain: "nirman-manager-f9aa4.firebaseapp.com",
    projectId: "nirman-manager-f9aa4",
    storageBucket: "nirman-manager-f9aa4.firebasestorage.app",
    messagingSenderId: "882377352623",
    appId: "1:882377352623:web:288932793fb16a4627bb5a"
  };
  const FCM_VAPID_KEY = "BHpQITKjI8oNKFM99NwE5X8ztVSgvgAWWj9ik30CzB0JemIffALo3NndKbOlRdEE80hEVEaEkrkdeOWc1aGWSec";
  let fbDb = null, fbMessaging = null;

  function getDeviceId(){
    let id = localStorage.getItem('nm_device_id');
    if(!id){ id = 'dev_'+uid(); localStorage.setItem('nm_device_id', id); }
    return id;
  }

  async function initFirebaseMessaging(swReg){
    try{
      if(!window.firebase) return;
      if(!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
      fbDb = firebase.firestore();
      if(!('Notification' in window) || Notification.permission!=='granted') return;
      fbMessaging = firebase.messaging();
      const token = await fbMessaging.getToken({vapidKey: FCM_VAPID_KEY, serviceWorkerRegistration: swReg});
      if(token){
        await fbDb.collection('pushTokens').doc(getDeviceId()).set({
          token, updatedAt: firebase.firestore.FieldValue.serverTimestamp()
        });
      }
    }catch(e){ console.warn('Firebase messaging setup skipped:', e.message); }
  }

  async function scheduleServerReminder(title, body, sendAtDate){
    if(!fbDb) return;
    try{
      await fbDb.collection('scheduledNotifications').add({
        deviceId: getDeviceId(), title, body,
        sendAt: firebase.firestore.Timestamp.fromDate(sendAtDate),
        sent: false, createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
    }catch(e){ console.warn('Could not schedule server push:', e.message); }
  }

  let swRegistration = null;

  function registerServiceWorker(){
    if(!('serviceWorker' in navigator)) return;
    navigator.serviceWorker.register('./service-worker.js').then(reg=>{
      swRegistration = reg;
      initFirebaseMessaging(reg);
      // Best-effort periodic background sync (only works on installed PWA, Chromium/Android,
      // and the interval is decided by the browser — not exact-time reminders).
      if('periodicSync' in reg){
        navigator.permissions.query({name:'periodic-background-sync'}).then(status=>{
          if(status.state==='granted'){
            reg.periodicSync.register('nirman-reminder-check', {minInterval:15*60*1000}).catch(()=>{});
          }
        }).catch(()=>{});
      }
    }).catch(()=>{});
    navigator.serviceWorker.addEventListener('message', (event)=>{
      if(event.data && event.data.type==='CHECK_REMINDERS'){
        checkNoteReminders();
        checkSitePhotoReminders();
      }
    });
  }

  function applyBottomNavLabels(){
    const map = {bnavLabelHome:'home_nav', bnavLabelAttendance:'attendance_nav', bnavLabelPayments:'payments_nav', bnavLabelTasks:'tasks_nav', bnavLabelMore:'more_nav'};
    Object.keys(map).forEach(id=>{
      const el = document.getElementById(id);
      if(el) el.textContent = t(map[id]);
    });
    applyDrawerLabels();
  }
  function applyDrawerLabels(){
    const map = {
      dlblHome:'home_nav', dlblLabourers:'labourers', dlblMasons:'masons', dlblDrivers:'drivers', dlblSupervisors:'supervisors',
      dlblVehicles:'vehicles_title', dlblEquipment:'equipment_title', dlblInventory:'saman_inventory_title', dlblOtherExp:'other_expenses_title',
      dlblUdhar:'udhar_title', dlblRent:'rent_title', dlblAttendance:'attendance_nav', dlblPayments:'payments_nav',
      dlblPL:'profit_loss_title', dlblFullReports:'full_reports_title', dlblNotes:'notes_title', dlblSiteTasks:'site_tasks_title',
      dlblTodoList:'todo_list_title', dlblUnitConv:'unit_converter_title', dlblBackup:'backup_restore_title', dlblCompanyInfo:'company_info_title'
    };
    Object.keys(map).forEach(id=>{
      const el = document.getElementById(id);
      if(el) el.textContent = t(map[id]);
    });
    const lsi = document.getElementById('locSearchInput');
    if(lsi) lsi.placeholder = t('msg_search_place');

    const staticText = {
      cropCancelBtn:'cancel_word', confirmCancelBtn:'cancel_word', confirmOkBtn:'delete_word',
      createPwBtn:'btn_create_password', enterPwBtn:'btn_unlock', checkAnsBtn:'btn_continue', saveResetBtn:'btn_save_new_password',
      cropTitleTxt:'crop_photo_title', cropHintTxt:'crop_hint', aiSendBtn:'btn_send_word'
    };
    Object.keys(staticText).forEach(id=>{
      const el = document.getElementById(id);
      if(el) el.textContent = t(staticText[id]);
    });
    const staticPh = {
      homeSearchBar:'ph_search_wsp', gsInput:'ph_search_name_hint', aiInput:'ph_ai_example',
      nq:'ph_recovery_q', na:'ph_recovery_a', fans:'ph_your_answer'
    };
    Object.keys(staticPh).forEach(id=>{
      const el = document.getElementById(id);
      if(el) el.placeholder = t(staticPh[id]);
    });
  }
  function startApp(){
    applyBottomNavLabels();
    render();
    document.getElementById('bottomNav').classList.add('show');
    registerServiceWorker();
    initAiWidget();
    initGlobalSearch();
    if('Notification' in window && Notification.permission==='default'){
      Notification.requestPermission().then(()=>{
        if(swRegistration) initFirebaseMessaging(swRegistration);
      });
    }
    checkNoteReminders();
    checkSitePhotoReminders();
    checkAttendanceReminder();
    setInterval(()=>{ checkNoteReminders(); checkSitePhotoReminders(); checkAttendanceReminder(); }, 20000);
  }

  if(localStorage.getItem('nm_dark_mode')==='1'){ document.body.setAttribute('data-theme','dark'); }
  checkAuthOnLoad();
})();
</script>
