  function countPresentToday(kind){
    const today = todayStr();
    const ids = new Set();
    attendance.filter(a=>a.date===today && a.workerType===kind && (a.status==='P'||a.status==='H')).forEach(a=>ids.add(a.workerId));
    return ids.size;
  }
  function countPresentTodayDetailed(kind){
    const today = todayStr();
    const store = WORKER_STORE[kind]().filter(p=>!p.leftCompany);
    const regularIds = new Set(store.filter(p=>!p.isGuest).map(p=>p.id));
    const guestIds = new Set(store.filter(p=>p.isGuest).map(p=>p.id));
    const presentIds = new Set();
    attendance.filter(a=>a.date===today && a.workerType===kind && (a.status==='P'||a.status==='H')).forEach(a=>presentIds.add(a.workerId));
    const regularPresent = [...presentIds].filter(id=>regularIds.has(id)).length;
    const outsidePresent = [...presentIds].filter(id=>guestIds.has(id)).length;
    const totalRegular = regularIds.size;
    const absent = Math.max(0, totalRegular - regularPresent);
    return { regularPresent, totalRegular, absent, outsidePresent };
  }

