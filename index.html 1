  // ===================== COMPANY SETTINGS =====================
  // ===================== UNIT CONVERTER =====================
  const UC_UNITS = [
    {v:'mm', labelKey:'unit_mm', f:0.001},
    {v:'cm', labelKey:'unit_cm', f:0.01},
    {v:'dm', labelKey:'unit_dm', f:0.1},
    {v:'m',  labelKey:'unit_m', f:1},
    {v:'km', labelKey:'unit_km', f:1000},
    {v:'in', labelKey:'unit_in', f:0.0254},
    {v:'ft', labelKey:'unit_ft', f:0.3048},
    {v:'yd', labelKey:'unit_yd', f:0.9144},
    {v:'mi', labelKey:'unit_mi', f:1609.34}
  ];
  function renderUnitConverter(){
    setTopbar(t('unit_converter_title'), true);
    const st = state._uc || (state._uc = {from:'cm', to:'m', val:'1'});
    const optHtml = (sel)=>UC_UNITS.map(u=>`<option value="${u.v}" ${u.v===sel?'selected':''}>${t(u.labelKey)}</option>`).join('');
    app.innerHTML = `
      <div class="form-box">
        <label>${t('from_label')}</label>
        <select id="ucFrom">${optHtml(st.from)}</select>
        <div style="text-align:center;margin:14px 0;">
          <button class="icon-btn edit" id="ucSwap" style="width:44px;height:44px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;"><path d="M7 10L3 6l4-4"/><path d="M3 6h13a4 4 0 0 1 4 4v1"/><path d="M17 14l4 4-4 4"/><path d="M21 18H8a4 4 0 0 1-4-4v-1"/></svg>
          </button>
        </div>
        <label>${t('to_label')}</label>
        <select id="ucTo">${optHtml(st.to)}</select>
        <label>${t('value_label')}</label>
        <input type="number" id="ucVal" value="${st.val}" step="any">
      </div>
      <div class="uc-result-card">
        <div class="uc-result-glow"></div>
        <div class="uc-result-num" id="ucResult">-</div>
        <div class="uc-result-unit" id="ucResultUnit"></div>
      </div>`;
    function calc(){
      const from = document.getElementById('ucFrom').value;
      const to = document.getElementById('ucTo').value;
      const valRaw = document.getElementById('ucVal').value;
      st.from=from; st.to=to; st.val=valRaw;
      const val = parseFloat(valRaw);
      const fu = UC_UNITS.find(u=>u.v===from), tu = UC_UNITS.find(u=>u.v===to);
      const resEl = document.getElementById('ucResult'), unitEl = document.getElementById('ucResultUnit');
      if(isNaN(val)){ resEl.textContent='-'; unitEl.textContent=''; return; }
      const out = val*fu.f/tu.f;
      const rounded = Math.round(out*1e6)/1e6;
      resEl.textContent = rounded;
      unitEl.textContent = t(tu.labelKey);
    }
    document.getElementById('ucFrom').addEventListener('change', calc);
    document.getElementById('ucTo').addEventListener('change', calc);
    document.getElementById('ucVal').addEventListener('input', calc);
    document.getElementById('ucSwap').addEventListener('click', ()=>{
      const f=document.getElementById('ucFrom').value, t=document.getElementById('ucTo').value;
      document.getElementById('ucFrom').value=t; document.getElementById('ucTo').value=f;
      calc();
    });
    calc();
  }

