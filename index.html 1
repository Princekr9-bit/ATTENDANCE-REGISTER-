          e.stopPropagation();
          showConfirmModal(t('confirm_remove_ai_key'), ()=>{
            localStorage.removeItem('nm_gemini_key');
            state._geminiKeyOpen = false;
            renderGeminiKeyBox();
          }, t('remove_word'));
        });
      } else {
        box.innerHTML = `<label>${t('lbl_gemini_key')}</label>
          <input type="text" id="geminiKeyInput" value="${savedKey}" placeholder="${t('msg_ai_key_placeholder')}">
          <button class="save-btn" id="geminiKeySave">${t('btn_save_key')}</button>`;
        document.getElementById('geminiKeySave').addEventListener('click', ()=>{
          const key = document.getElementById('geminiKeyInput').value.trim();
          localStorage.setItem('nm_gemini_key', key);
          state._geminiKeyEditing = false;
          state._geminiKeyOpen = false;
          renderGeminiKeyBox();
          showInfoModal(t('msg_ai_key_saved'));
        });
      }
    }
    renderGeminiKeyBox();
    document.getElementById('cSave').addEventListener('click', ()=>{
      company = {name:document.getElementById('cName').value.trim()||t('lbl_default_company_name'), logo:logoData};
      save(K.company, company);
      goTo('dashboard');
    });
    document.getElementById('langSaveBtn').addEventListener('click', function(){
      const sel = document.getElementById('langSelect').value;
      state._lang = sel;
      save('nm_lang', sel);
      applyBottomNavLabels();
      showInfoModal(t('msg_saved_lang'));
      render();
    });
    bindPwToggles();
    document.getElementById('pwSaveBtn').addEventListener('click', async ()=>{
      const cur = document.getElementById('curPw').value;
      const n1 = document.getElementById('newPw1').value;
      const n2 = document.getElementById('newPw2').value;
      const errEl = document.getElementById('pwErr');
      const authNow = load(K.auth, null);
      const curHash = await hashText(cur);
      if(!authNow || curHash!==authNow.passHash){ errEl.textContent=t('err_current_pw_wrong'); return; }
      if(!n1 || n1.length<4){ errEl.textContent=t('err_new_pw_min_len'); return; }
      if(n1!==n2){ errEl.textContent=t('err_new_pw_mismatch'); return; }
      authNow.passHash = await hashText(n1);
      save(K.auth, authNow);
      errEl.style.color = 'var(--green)';
      errEl.textContent = t('msg_pw_updated');
    });

    const removePatternBtn = document.getElementById('removePattern');
    if(removePatternBtn) removePatternBtn.addEventListener('click', ()=>{
      const a = load(K.auth, {}); delete a.patternHash; save(K.auth, a); render();
    });
    const removeFpBtn = document.getElementById('removeFp');
    if(removeFpBtn) removeFpBtn.addEventListener('click', ()=>{
      const a = load(K.auth, {}); delete a.webauthnCredId; save(K.auth, a); render();
    });
    const startPatternBtn = document.getElementById('startPatternSetup');
    if(startPatternBtn) startPatternBtn.addEventListener('click', ()=>{ state._patternSetupStep=1; render(); });
    const cancelPatternBtn = document.getElementById('cancelPatternSetup');
    if(cancelPatternBtn) cancelPatternBtn.addEventListener('click', ()=>{ state._patternSetupStep=0; state._patternTemp=null; render(); });
    if(patternStep>0){
      attachPatternGrid('setupPatternGrid', async (path)=>{
        if(patternStep===1){
          state._patternTemp = path;
          state._patternSetupStep = 2;
          render();
        } else {
          const first = state._patternTemp || [];
          if(first.join('-')===path.join('-')){
            const a = load(K.auth, {});
            a.patternHash = await hashText(patternToHashInput(path));
            save(K.auth, a);
            state._patternSetupStep = 0;
            state._patternTemp = null;
            render();
          } else {
            document.getElementById('patternSetupErr').textContent = t('err_pattern_no_match');
            state._patternSetupStep = 1;
            state._patternTemp = null;
            setTimeout(()=>render(), 900);
          }
        }
      });
    }
    const startFpBtn = document.getElementById('startFpSetup');
    if(startFpBtn) startFpBtn.addEventListener('click', async ()=>{
      const ok = await setupFingerprint();
      if(ok) render();
    });
  }

  // ===================== APP START =====================
