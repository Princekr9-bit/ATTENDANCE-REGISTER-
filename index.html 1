  // ===================== DAILY HISTORY (any date's full record) =====================
  function buildTrendLineChartHtml(monthsData, yearLabel){
    const W = 340, H = 190, padL = 40, padR = 8, padT = 14, padB = 22;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const profits = monthsData.map(m=>m.inc - m.exp);
    const allVals = [...monthsData.map(m=>m.inc), ...monthsData.map(m=>m.exp), ...profits];
    const maxV = Math.max(1, ...allVals);
    const minV = Math.min(0, ...allVals);
    const range = Math.max(1, maxV - minV);
    const n = monthsData.length;
    const xFor = (i)=> padL + (n<=1 ? 0 : (i/(n-1))*plotW);
    const yFor = (v)=> padT + plotH - ((v-minV)/range)*plotH;
    function pathFor(vals){
      return vals.map((v,i)=>`${i===0?'M':'L'}${xFor(i).toFixed(1)},${yFor(v).toFixed(1)}`).join(' ');
    }
    const incVals = monthsData.map(m=>m.inc);
    const expVals = monthsData.map(m=>m.exp);
    const incPath = pathFor(incVals);
    const expPath = pathFor(expVals);
    const proPath = pathFor(profits);
    const zeroY = yFor(0).toFixed(1);
    const areaPath = `${incPath} L${xFor(n-1).toFixed(1)},${zeroY} L${xFor(0).toFixed(1)},${zeroY} Z`;

    // gridlines with rupee labels, 4 bands
    const gridCount = 4;
    let gridHtml = '';
    for(let g=0; g<=gridCount; g++){
      const v = minV + (range*g/gridCount);
      const gy = yFor(v).toFixed(1);
      gridHtml += `<line x1="${padL}" y1="${gy}" x2="${W-padR}" y2="${gy}" stroke="#EEF0F4" stroke-width="1"/>`;
      gridHtml += `<text x="${padL-6}" y="${(+gy+3).toFixed(1)}" font-size="8" fill="#8A93A3" text-anchor="end">₹${rupeeShort(v)}</text>`;
    }

    function markers(vals, color){
      return vals.map((v,i)=>`<circle cx="${xFor(i).toFixed(1)}" cy="${yFor(v).toFixed(1)}" r="2.6" fill="${color}" stroke="#fff" stroke-width="1"/>`).join('');
    }

